#!/usr/bin/env python3
"""Probe the CoaProbe addon of a running lab client through the worldserver's probe relay (SOAP `.labprobe`),
without /reload. Needs a slot prepared with `coa-client-lab relay-setup` and a lab descriptor written by
`coa-client-lab login ACCOUNT PASSWORD CHARACTER`.

    coa-lab-relay [--descriptor PATH] probe COMMAND [ARGS...]   prints the answer as JSON
    coa-lab-relay soap COMMAND                                  prints the raw command output (uses relay.env)
"""
import argparse
import base64
import json
import os
import secrets
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path
from xml.etree import ElementTree
from xml.sax.saxutils import escape

DESCRIPTOR_KEYS = ("instance", "slot", "soap_url", "soap_account", "soap_password_file", "account", "character",
                   "deployed_commit", "preflight")

ENVELOPE = (
    '<?xml version="1.0" encoding="UTF-8"?>'
    '<SOAP-ENV:Envelope xmlns:SOAP-ENV="http://schemas.xmlsoap.org/soap/envelope/" xmlns:ns1="urn:AC">'
    "<SOAP-ENV:Body><ns1:executeCommand><command>{command}</command></ns1:executeCommand></SOAP-ENV:Body>"
    "</SOAP-ENV:Envelope>"
)


class SoapFault(Exception):
    pass


def _local(tag: str) -> str:
    return tag.rsplit("}", 1)[-1]


def _find(root, name):
    for element in root.iter():
        if _local(element.tag) == name:
            return element
    return None


def soap_execute(url: str, account: str, password: str, command: str, timeout: float = 10.0) -> str:
    body = ENVELOPE.format(command=escape(command)).encode("utf-8")
    request = urllib.request.Request(url, data=body, method="POST")
    request.add_header("Content-Type", "text/xml; charset=utf-8")
    token = base64.b64encode(f"{account}:{password}".encode()).decode()
    request.add_header("Authorization", f"Basic {token}")
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            payload = response.read()
    except urllib.error.HTTPError as error:
        payload = error.read()
        error.close()
        if not payload or error.code in (401, 403):
            raise SoapFault(f"HTTP {error.code} from {url}") from None
    try:
        root = ElementTree.fromstring(payload)
    except ElementTree.ParseError as error:
        raise SoapFault(f"unreadable SOAP reply: {error}: {payload[:200]!r}") from None
    fault = _find(root, "Fault")
    if fault is not None:
        text = _find(fault, "faultstring")
        raise SoapFault((text.text or "").strip() if text is not None else "SOAP fault")
    result = _find(root, "result")
    if result is None:
        raise SoapFault(f"no result element in SOAP reply: {payload[:200]!r}")
    return result.text or ""


def load_descriptor(path: Path) -> dict:
    try:
        descriptor = json.loads(Path(path).read_text())
    except OSError as error:
        raise SystemExit(f"no lab descriptor at {path}: {error.strerror}") from None
    missing = [key for key in DESCRIPTOR_KEYS if key not in descriptor]
    if missing:
        raise ValueError(f"lab descriptor {path} lacks {', '.join(missing)}")
    return descriptor


def _password(descriptor: dict) -> str:
    return Path(descriptor["soap_password_file"]).read_text().strip()


def probe(descriptor: dict, line: str, timeout: float = 10.0, poll: float = 0.2) -> dict:
    password = _password(descriptor)
    character = descriptor["character"]
    req = "r" + secrets.token_hex(6)

    def run(command: str) -> str:
        return soap_execute(descriptor["soap_url"], descriptor["soap_account"], password, command).strip()

    started = time.monotonic()
    run(f".labprobe send {character} {req} {line}")
    status = "unsent"
    while True:
        status = run(f".labprobe result {character} {req}")
        if status.startswith("complete "):
            answer = json.loads(base64.b64decode(status.split(" ", 1)[1]).decode("utf-8"))
            answer["elapsed_ms"] = int((time.monotonic() - started) * 1000)
            return answer
        if time.monotonic() - started >= timeout:
            raise TimeoutError(f"no relay answer from {character} for {req} after {timeout:g}s "
                               f"(last status: {status})")
        time.sleep(poll)


def read_env(path: Path) -> dict:
    values = {}
    for line in path.read_text().splitlines():
        key, sep, value = line.partition("=")
        if sep and key.strip() and not key.startswith("#"):
            values[key.strip()] = value.strip()
    return values


def main(argv=None) -> int:
    lab_root = Path(os.environ.get("COA_LAB_ROOT", Path.home() / "CoaServer/client-lab"))
    instance = os.environ.get("COA_LAB_INSTANCE", "")
    state_dir = lab_root / "state" / instance if instance else lab_root / "state"
    parser = argparse.ArgumentParser(prog="coa-lab-relay")
    parser.add_argument("--descriptor", type=Path, default=state_dir / "lab.json")
    sub = parser.add_subparsers(dest="command", required=True)
    probe_parser = sub.add_parser("probe", help="ask the lab client's CoaProbe addon")
    probe_parser.add_argument("--timeout", type=float, default=10.0)
    probe_parser.add_argument("words", nargs="+")
    soap_parser = sub.add_parser("soap", help="run one GM command over SOAP")
    soap_parser.add_argument("words", nargs="+")
    args = parser.parse_args(argv)
    try:
        if args.command == "probe":
            answer = probe(load_descriptor(args.descriptor), " ".join(args.words), timeout=args.timeout)
            print(json.dumps(answer, ensure_ascii=False, sort_keys=True))
        else:
            env = read_env(lab_root / "relay.env")
            password = Path(env["SOAP_PASSWORD_FILE"]).read_text().strip()
            print(soap_execute(env["SOAP_URL"], env["SOAP_ACCOUNT"], password, " ".join(args.words)))
    except (SoapFault, TimeoutError, ValueError, OSError) as error:
        print(f"coa-lab-relay: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
