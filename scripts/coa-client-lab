#!/usr/bin/env bash
# Run a lab copy of the CoA client for agents: nested gamescope on its own Hyprland workspace, keyboard input
# and screenshots through gamescope's X display, one lab client at a time. The user's client is never modified;
# it is only read by `create`. Design: docs/design/client-issue-agent.md.
set -euo pipefail

USER_CLIENT="${COA_USER_CLIENT:-$HOME/CoaServer/client/ascension-live}"
USER_PREFIX="${COA_USER_PREFIX:-$HOME/Games/umu/coa-client}"
LAB_ROOT="${COA_LAB_ROOT:-$HOME/CoaServer/client-lab}"
BASE_CLIENT="$LAB_ROOT/ascension-lab"
BASE_PREFIX="${COA_LAB_PREFIX:-$HOME/Games/umu/coa-client-lab}"
INSTANCE="${COA_LAB_INSTANCE:-}"
if [[ -n "$INSTANCE" ]]; then
    [[ "$INSTANCE" =~ ^[1-9]$ ]] || { printf 'ERROR: COA_LAB_INSTANCE must be 1-9 or empty\n' >&2; exit 1; }
    INSTANCE_DIR="$LAB_ROOT/instances/$INSTANCE"
    LAB_CLIENT="$INSTANCE_DIR/ascension-lab"
    LAB_PREFIX="${BASE_PREFIX%/}-$INSTANCE"
else
    INSTANCE_DIR=""
    LAB_CLIENT="$BASE_CLIENT"
    LAB_PREFIX="$BASE_PREFIX"
fi
PROTON="${COA_PROTONPATH:-$HOME/.local/share/Steam/compatibilitytools.d/GE-Proton11-6-x86_64}"
WORKSPACE="${COA_LAB_WORKSPACE:-9}"
WINDOW_TIMEOUT="${COA_LAB_WINDOW_TIMEOUT:-120}"
STOP_TIMEOUT="${COA_LAB_STOP_TIMEOUT:-30}"
SLEEP="${COA_LAB_SLEEP:-sleep}"
SILENT_SINK="${COA_LAB_SILENT_SINK:-coa_client_lab_silence}"
PROBE_TIMEOUT="${COA_LAB_PROBE_TIMEOUT:-30}"
RELOAD_WAIT="${COA_LAB_RELOAD_WAIT:-10}"
LOGIN_WAIT="${COA_LAB_LOGIN_WAIT:-20}"
REALM_WAIT="${COA_LAB_REALM_WAIT:-25}"
WORLD_WAIT="${COA_LAB_WORLD_WAIT:-45}"
UI_READY_WAIT="${COA_LAB_UI_READY_WAIT:-30}"
LOGIN_ATTEMPTS="${COA_LAB_LOGIN_ATTEMPTS:-2}"
LOGIN_DISCONNECTED_EXIT=75
LOGIN_REJECTED_EXIT=76
GLUE_STATE_RETRY_ATTEMPTS="${COA_LAB_GLUE_STATE_RETRY_ATTEMPTS:-3}"
GLUE_STATE_RETRY_WAIT="${COA_LAB_GLUE_STATE_RETRY_WAIT:-1}"
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
ADDON_SRC="$SCRIPT_DIR/../addons/CoaProbe"
PROBE_READER="$SCRIPT_DIR/coa-probe-read.py"
RELAY="${COA_LAB_RELAY:-$SCRIPT_DIR/coa-lab-relay}"
# Read-only glue/world memory reader (scripts/coa-lab-mem): same guards as every other read (lab exe under the
# lab root, lab slot from the lock, Warden.Enabled = 0). `login` treats it as advisory, never required: any
# failure to run it (missing python3, guard refusal, unexpected output) falls back to the pixel-check path below.
LAB_MEM="${COA_LAB_MEM:-$SCRIPT_DIR/coa-lab-mem}"
# Commands the server relay and the addon accept over addon whispers; everything else keeps the /reload path.
RELAY_COMMANDS=" ping spell item auras spellbook known log state ca frame errors "
# The Ghost e2e harness checkout `character` and `login`'s character-select navigation build against
# (scripts/lab-character). Overridable so the Go module in this guide never hard-codes one user's home.
GHOST_REPO="${COA_GHOST_REPO:-$HOME/Projects/ConquestOfAzerothGhost}"
LAB_CHARACTER_DIR="$SCRIPT_DIR/lab-character"
PROFILE="${COA_LAB_PROFILE:-readable}"
FPS="${COA_LAB_FPS:-10}"
# 800x600 cuts the character pane's Ranged block off the bottom of the window (confirmed live, slot 2,
# 2026-10-26, level 20 character, C key). 1024x768 (still 4:3: a non-4:3 height such as 800x720
# letterboxes, confirmed live, and the game renders its glue/world scenes into the letterboxed area only)
# shows more of it but the Ranged block's last rows can still clip; the attributes list is a scrollable
# Blizzard frame (mouse wheel reaches the rest at any resolution, confirmed live) and no resolution tried
# up to 1280x1024, with or without a smaller /console uiScale, made the whole thing fit unscrolled. 1024x768
# is kept as the default for being a real, evidenced improvement over 800x600, not a confirmed full fix;
# COA_LAB_WIDTH/HEIGHT already override it, and a non-4:3 pair should be avoided (see above).
if [[ "$PROFILE" == minimal ]]; then
    DISPLAY_MODE="${COA_LAB_DISPLAY:-headless}"
    WIDTH="${COA_LAB_WIDTH:-1024}"
    HEIGHT="${COA_LAB_HEIGHT:-768}"
else
    DISPLAY_MODE="${COA_LAB_DISPLAY:-nested}"
    WIDTH="${COA_LAB_WIDTH:-1920}"
    HEIGHT="${COA_LAB_HEIGHT:-1080}"
fi
# Low-cost settings of the minimal profile. Each name was found in the lab Ascension.exe (strings) or is already
# in the lab Config.wtf; see docs/design/client-lab-level3.md for the kept and dropped candidates.
MINIMAL_CVARS=(
    "maxFPS=$FPS" "maxFPSBk=5" "farclip=177" "groundEffectDensity=16" "environmentDetail=0.5"
    "particleDensity=0.1" "weatherDensity=0" "spellEffectLevel=0" "specular=0" "projectedTextures=0"
    "textureFilteringMode=0" "baseMip=1" "ffxGlow=0" "ffxDeath=0" "showfootprints=0"
)
# Silence for both profiles (reports/l7): the client rewrites its own Config.wtf on exit, discarding
# whatever `create` wrote once, so these have to be reasserted on every start, not just once at creation.
# Written before the client launches instead of through post-login /console commands, which cost a chat
# round trip (~2s) per setting and only take effect after the world has already loaded once.
SOUND_CVARS=(
    "Sound_EnableAllSound=0" "Sound_EnableSFX=0" "Sound_EnableAmbience=0" "Sound_EnableMusic=0"
    "Sound_EnableErrorSpeech=0" "Sound_MasterVolume=0"
)
STATE_DIR="$LAB_ROOT/state${INSTANCE:+/$INSTANCE}"
LOCK="$STATE_DIR/lock"

usage() {
    cat <<'EOF'
Usage: coa-client-lab <command> [arguments]

Lab copy:
  create                   reflink-copy the user's client and Wine prefix, drop accounts, glue config and cache,
                           set 1920x1080
  destroy --yes            remove the lab client and prefix (refused while the lab client runs)

Instances (several lab clients side by side; select one with COA_LAB_INSTANCE=1..9 for every command):
  create-instance          reflink-copy the base lab client and prefix for COA_LAB_INSTANCE
  destroy-instance --yes   remove that instance's client and prefix (refused while it runs)

Running (one lab client per instance):
  start N                  point the lab client at slot N's authserver and launch it (env: COA_LAB_PROFILE
                           readable|minimal, COA_LAB_DISPLAY nested|headless (minimal defaults to headless),
                           COA_LAB_WIDTH/HEIGHT, COA_LAB_FPS)
  login ACCOUNT PASSWORD [CHARACTER]
                           keyboard login and world entry; dismisses a leftover glue modal first. With
                           CHARACTER, navigates the character list to it before entering the world (falls
                           back to the default highlighted character if the lookup fails) and, on a
                           relay-setup slot, writes the lab descriptor state/lab.json used by relay probes
  login CHARACTER         same, for a character made by `character` without --account: resolves the
                           dedicated account and its generated password itself, so there is never a
                           character list to navigate
  login --account NAME CHARACTER
                           same, for a shared account made by `character --account NAME ...`: resolves
                           NAME's generated password itself (secrets/, see ensure_lab_password), so no
                           password ever appears on the command line; navigates to CHARACTER in the
                           account's character list the same way as `login ACCOUNT PASSWORD CHARACTER`
  character --slot N [--account A] --character C --race R --class K [--level N] [--spec ID] [--gm N]
            [--learn ID,ID,...] [--items ID,ID,...] [--bag-items ID,ID,...]
                           create or update one lab test character through the Ghost e2e harness, on any
                           slot; an existing character of a different class is refused, never deleted; class must be a CoA class id (12-32); prints JSON.
                           Without --account, uses a dedicated account for this character alone (COALAB +
                           the character name, see derive_account), with a generated password saved under
                           secrets/ and reused on later calls; refuses if that account already holds a
                           different character. With --account, the named account's password is generated
                           or reused the same way (secrets/<account>.password) and always re-applied to
                           the account's real DB password, so `login --account NAME CHARACTER` always has
                           a valid password to read back, even if the account pre-existed with a different
                           one. Warns once the account holds 2+ characters, since navigating to CHARACTER
                           by name then needs lab-client memory to be usable this session
                           (select_character_via_memory); without memory it is not implemented
                           (select_character) and login lands on whichever character is already
                           highlighted. --items must equip (a refusal fails the call, so a class-restricted
                           piece is never silently missing); --bag-items only adds to the bags
  goto-spawn gameobject|creature (--entry ID | --guid ID) [--distance YD] [--bearing DEG] [--dz YD]
                           stand YD yards (default 8) from a spawn read from the slot database, at compass
                           BEARING degrees from it (0 = east, 90 = north), facing it, via `.go xyz`; --dz
                           raises or lowers the landing point (the server snaps heights to the ground). Prints the spawn, the line it
                           typed and where the character really landed (`.gps`); revives a dead character first,
                           and again if it died on landing
  camera status | reset | pitch up|down MS | yaw left|right MS | zoom in|out MS
                           move the third-person camera on its own (Lua MoveView*), independent of the
                           character's facing; `pitch up` raises the camera until it looks down on the
                           character. Each move runs for MS milliseconds of client time and prints the
                           resulting pitch; the client applies pitch in bursts, so converge by reading
                           `status` (pitch -89..89 degrees). The angle is saved per character and survives
                           relogs: `reset` returns to the default third-person view
  type TEXT                type text into the client
  key KEY...               send keys (xdotool names: Return, Tab, Escape, BackSpace...)
  chat TEXT                Return, type TEXT, Return (slash commands, /say...)
  screenshot [PATH]        save a PNG of the client window and print its path
  screenshot --burst N [--interval-ms MS] [--dir DIR] [--chat TEXT | --key KEY...]
                           capture N frames (default interval 100ms, at most that by design -- see
                           docs/adr/0013) inside this one call, into DIR (default under
                           screenshots/burst-<timestamp>-<pid>/, frame-000.png...); with --chat/--key, fires
                           that action first, in the same call, then starts capturing immediately -- no
                           second dispatch between the action and the first frame. Prints DIR; DIR/timing.tsv
                           has the action and every frame's start/end (ns since epoch) for measuring the
                           achieved interval and the action-to-first-frame delay
  screenshot --video-seconds S [--fps N] [--dir DIR] [--chat TEXT | --key KEY...]
                           same, but records DIR/clip.mp4 via ffmpeg x11grab for S seconds at --fps
                           (default 10) instead of discrete frames
  hold KEY MILLISECONDS    hold a key down (walk with w/s, turn with Left/Right)
  mute                     mute this lab client's audio streams (start does it too)
  probe COMMAND [ARGS...]  ask the CoaProbe addon (ping, spell ID, item ID, auras [UNIT], spellbook, known ID,
                           ca [ENTRY], log [n], state, frame NAME, actionbar, perf start [MS]|stop, errors [N] [previous] [locals],
                           pksend OPCODE [u32:N u8:N s:TEXT ...],
                           pkwatch OPCODE [BYTES], pkmeta, pkfind, evwatch EVENT, evunwatch EVENT, eval EXPR,
                           pkunwatch OPCODE); prints JSON. With state/lab.json, read-only commands go through the
                           server relay (coa-lab-relay, no /reload); COA_LAB_TRANSPORT=reload forces /reload
  revive [CHARACTER]       revive a dead or ghost lab character server-side over the SOAP relay (.revive), releasing
                           the spirit and retrying once if it is still dead; the
                           client's chat box refuses every input, GM commands included, while the character is
                           dead. CHARACTER defaults to the last one that reached world; needs relay-setup
  erase CHARACTER [--account A] [--slot N]
                           delete a throwaway lab character over the SOAP relay (`character erase` is not grantable
                           to in-game GMs); with no --account, also deletes its dedicated COALAB account and
                           password file. Refuses a character that does not belong to a COALAB account (checked with
                           pinfo), a non-COALAB account and the relay's own SOAP account
  stop                     stop the lab client by PID, release the lock, warn if the user's client changed
  status                   lock holder, process, display and window
  preflight N              coa-slot preflight N against the lab client's data; records pass/fail, slot and time
                           for lab.json (a pass counts only for that slot and after its last deploy; stop clears it)

Server relay:
  relay-setup N --soap-account NAME --soap-password-file PATH
                           enable SOAP (container 0.0.0.0, host loopback) and CoA.ProbeRelay.Enable in slot N's
                           configuration and write relay/slotN.env; restart the worldserver afterwards
EOF
}

step() { printf '==> %s\n' "$*"; }
die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

# Replace `SET key "value"` in a WTF file, or append it.
set_wtf() {
    local file="$1" key="$2" value="$3"
    if grep -qi "^SET $key " "$file"; then
        sed -i "s|^SET $key .*|SET $key \"$value\"|I" "$file"
    else
        printf 'SET %s "%s"\n' "$key" "$value" >> "$file"
    fi
}

# Replace the `KEY = value` line of a worldserver-style .conf file, or append it.
set_conf() {
    local file="$1" key="$2" value="$3" escaped
    escaped=$(printf '%s' "$key" | sed 's/\./\\./g')
    if grep -q "^$escaped *=" "$file"; then
        sed -i "s|^$escaped *=.*|$key = $value|" "$file"
    else
        printf '%s = %s\n' "$key" "$value" >> "$file"
    fi
}

# Written before every start: the client rewrites Config.wtf on exit.
apply_profile() {
    local config="$LAB_CLIENT/WTF/Config.wtf" setting
    set_wtf "$config" gxResolution "${WIDTH}x${HEIGHT}"
    for setting in "${SOUND_CVARS[@]}"; do
        set_wtf "$config" "${setting%%=*}" "${setting#*=}"
    done
    [[ "$PROFILE" == minimal ]] || return 0
    for setting in "${MINIMAL_CVARS[@]}"; do
        set_wtf "$config" "${setting%%=*}" "${setting#*=}"
    done
}

# I2: shared by create and destroy. Resolve every lab and user path with `realpath -m` (symlinks, "..",
# trailing slashes) and refuse if any lab path equals, contains or is contained by any user path, so a
# moved COA_LAB_ROOT, a trailing-slash COA_LAB_PREFIX or a symlinked alias cannot reach the user's data.
check_lab_paths() {
    local lab_root lab_client lab_prefix user_client user_prefix lab user
    lab_root=$(realpath -m -- "$LAB_ROOT")
    lab_client=$(realpath -m -- "$LAB_CLIENT")
    lab_prefix=$(realpath -m -- "$LAB_PREFIX")
    user_client=$(realpath -m -- "$USER_CLIENT")
    user_prefix=$(realpath -m -- "$USER_PREFIX")
    for lab in "$lab_root" "$lab_client" "$lab_prefix"; do
        for user in "$user_client" "$user_prefix"; do
            [[ "$lab/" == "$user/"* || "$user/" == "$lab/"* ]] \
                && die "lab path aliases the user's path: $lab vs $user"
        done
    done
    return 0
}

cmd_create() {
    [[ -z "$INSTANCE" ]] || die "create makes the base lab; use create-instance for COA_LAB_INSTANCE"
    check_lab_paths
    [[ -e "$LAB_CLIENT" || -e "$LAB_PREFIX" ]] && die "lab already exists: $LAB_CLIENT or $LAB_PREFIX"
    [[ -f "$USER_CLIENT/Ascension.exe" ]] || die "Ascension.exe not found in $USER_CLIENT"
    [[ -d "$USER_PREFIX" ]] || die "Wine prefix not found: $USER_PREFIX"
    mkdir -p "$LAB_ROOT" "$(dirname "$LAB_PREFIX")"
    step "Copying the client and its prefix (reflink: shared blocks, no full copy)"
    cp -a --reflink=always "$USER_CLIENT" "$LAB_CLIENT" || die "reflink copy failed (needs btrfs or xfs)"
    cp -a --reflink=always "$USER_PREFIX" "$LAB_PREFIX" || die "reflink copy failed (needs btrfs or xfs)"
    # Mark both as ours: destroy refuses to rm -rf anything without this marker (I2).
    touch "$LAB_ROOT/.coa-client-lab" "$LAB_PREFIX/.coa-client-lab"
    # The user's remembered account, characters, addon settings and caches stay out of the lab.
    rm -rf "$LAB_CLIENT/WTF/Account" "$LAB_CLIENT/WTF/Custom" "$LAB_CLIENT/Cache" "$LAB_CLIENT/Screenshots"
    set_wtf "$LAB_CLIENT/WTF/Config.wtf" gxResolution "${WIDTH}x${HEIGHT}"
    # Silence: the lab client runs next to the user, and no check reads sound.
    set_wtf "$LAB_CLIENT/WTF/Config.wtf" Sound_EnableAllSound "0"
    set_wtf "$LAB_CLIENT/WTF/Config.wtf" Sound_EnableSFX "0"
    set_wtf "$LAB_CLIENT/WTF/Config.wtf" Sound_EnableAmbience "0"
    set_wtf "$LAB_CLIENT/WTF/Config.wtf" Sound_EnableMusic "0"
    set_wtf "$LAB_CLIENT/WTF/Config.wtf" Sound_EnableErrorSpeech "0"
    set_wtf "$LAB_CLIENT/WTF/Config.wtf" Sound_MasterVolume "0"
    # A remembered login (SET accountName ...) is account data too; drop it if the user ever ticked "remember".
    sed -i '/^SET accountName /Id' "$LAB_CLIENT/WTF/Config.wtf"
    echo "lab created: $LAB_CLIENT"
}

cmd_destroy() {
    [[ -z "$INSTANCE" ]] || die "destroy removes the base lab; use destroy-instance for COA_LAB_INSTANCE"
    [[ "${1:-}" == --yes ]] || die "usage: coa-client-lab destroy --yes"
    [[ -e "$LOCK" ]] && die "the lab client is running or its lock is stale: coa-client-lab stop"
    check_lab_paths
    local dir
    for dir in "$LAB_ROOT" "$LAB_PREFIX"; do
        [[ -e "$dir" && ! -e "$dir/.coa-client-lab" ]] \
            && die "$dir has no .coa-client-lab marker (not created by coa-client-lab create?): refusing to remove it"
    done
    rm -rf "$LAB_ROOT" "$LAB_PREFIX"
    echo "lab removed"
}

cmd_create_instance() {
    [[ -n "$INSTANCE" ]] || die "create-instance needs COA_LAB_INSTANCE=1..9"
    check_lab_paths
    [[ -f "$BASE_CLIENT/Ascension.exe" && -d "$BASE_PREFIX" ]] || die "no base lab: coa-client-lab create"
    [[ -e "$LAB_CLIENT" || -e "$LAB_PREFIX" ]] && die "instance $INSTANCE already exists: $LAB_CLIENT or $LAB_PREFIX"
    mkdir -p "$INSTANCE_DIR"
    step "Copying the base lab client and prefix for instance $INSTANCE (reflink)"
    cp -a --reflink=always "$BASE_CLIENT" "$LAB_CLIENT" || die "reflink copy failed (needs btrfs or xfs)"
    cp -a --reflink=always "$BASE_PREFIX" "$LAB_PREFIX" || die "reflink copy failed (needs btrfs or xfs)"
    touch "$INSTANCE_DIR/.coa-client-lab" "$LAB_PREFIX/.coa-client-lab"
    rm -rf "$LAB_CLIENT/WTF/Account" "$LAB_CLIENT/Cache" "$LAB_CLIENT/Screenshots"
    echo "instance $INSTANCE created: $LAB_CLIENT"
}

cmd_destroy_instance() {
    [[ -n "$INSTANCE" ]] || die "destroy-instance needs COA_LAB_INSTANCE=1..9"
    [[ "${1:-}" == --yes ]] || die "usage: COA_LAB_INSTANCE=N coa-client-lab destroy-instance --yes"
    [[ -e "$LOCK" ]] && die "instance $INSTANCE is running or its lock is stale: coa-client-lab stop"
    check_lab_paths
    local dir
    for dir in "$INSTANCE_DIR" "$LAB_PREFIX"; do
        [[ -e "$dir" && ! -e "$dir/.coa-client-lab" ]] \
            && die "$dir has no .coa-client-lab marker (not created by create-instance?): refusing to remove it"
    done
    rm -rf "$INSTANCE_DIR" "$LAB_PREFIX"
    rmdir "$STATE_DIR" 2>/dev/null || true
    echo "instance $INSTANCE removed"
}

# Locks of the other lab clients (base and instances) that are still held.
other_locks() {
    local lock
    for lock in "$LAB_ROOT/state/lock" "$LAB_ROOT"/state/*/lock; do
        [[ -e "$lock" && "$lock" != "$LOCK" ]] && echo "$lock"
    done
    return 0
}

descendants() {
    local child
    for child in $(pgrep -P "$1" || true); do
        echo "$child"
        descendants "$child"
    done
}

# Field 22 of /proc/<pid>/stat (process start time, clock ticks since boot), parsed after the last `)`
# so a comm field containing spaces or parens (unlikely here, but stat's format allows it) cannot shift
# the fixed fields that follow it. That split starts at field 3 (state), so field N is index N-3;
# field 22 (starttime) is index 19. Index 17 is field 20 (num_threads), not the start time.
gamescope_starttime() {
    local pid="$1" stat rest fields
    stat=$(cat "/proc/$pid/stat" 2>/dev/null) || return 1
    rest="${stat##*) }"
    read -r -a fields <<< "$rest"
    [[ -n "${fields[19]:-}" ]] || return 1
    echo "${fields[19]}"
}

# I1: a stale gamescope.pid can survive a crash or reboot; if its PID were reused by an unrelated
# process, trusting kill -0 alone could make `stop` signal the wrong process tree, possibly the user's
# own client. Require the PID to still look like gamescope (its cmdline mentions it; the test's fake is a
# bash script whose cmdline is `bash .../bin/gamescope`, so `comm` would read "bash" and must not be used)
# and to have the same start time `start` recorded, so PID reuse after the original process exited is caught.
gamescope_pid() {
    local pid starttime recorded
    pid=$(cat "$STATE_DIR/gamescope.pid" 2>/dev/null) && [[ -n "$pid" ]] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    tr '\0' '\n' < "/proc/$pid/cmdline" 2>/dev/null | grep -q 'gamescope' || return 1
    starttime=$(gamescope_starttime "$pid") || return 1
    recorded=$(cat "$STATE_DIR/gamescope.starttime" 2>/dev/null) || return 1
    [[ "$starttime" == "$recorded" ]] || return 1
    echo "$pid"
}

# gamescope's Xwayland display, read from the environment of a process gamescope started.
find_display() {
    local pid value
    for pid in $(descendants "$1"); do
        value=$(tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null | sed -n 's/^DISPLAY=//p' | head -1)
        [[ -n "$value" ]] && { echo "$value"; return 0; }
    done
    return 1
}

require_running() {
    [[ -e "$LOCK" ]] || die "the lab client is not running: coa-client-lab start N"
    gamescope_pid > /dev/null || die "lock present but gamescope is gone (the host's gamescope/Xwayland session died, seen with" \
        "libei events or a Wayland broken pipe); recover with: coa-client-lab stop && coa-client-lab start $(cat "$STATE_DIR/slot" 2> /dev/null || echo N)" \
        "&& coa-client-lab login $(lab_last_character 2> /dev/null || echo CHARACTER)"
    DISPLAY=$(cat "$STATE_DIR/display")
    WINDOW=$(cat "$STATE_DIR/window")
    export DISPLAY
}

# L15 problem 2: `coa-lab-mem`'s own guard hard-refuses every read while a slot has Warden.Enabled != 0
# (its own check_warden_disabled, reused here via `warden-status` rather than a second parser); a prior
# session (batch 22, slot 4) only learned that once a `coa-lab-mem` call had already
# failed. This prints the slot's Warden state up front, from `preflight` and from `start`, and never
# blocks either: Warden is the slot's own configuration, reported here, not changed by this tool.
warden_status_line() {
    local n="$1" json enabled
    if [[ ! -x "$LAB_MEM" ]] || ! command -v python3 > /dev/null 2>&1; then
        echo "warden: unknown for slot $n (coa-lab-mem/python3 unavailable)"
        return 0
    fi
    if ! json=$(python3 "$LAB_MEM" warden-status --slot "$n" 2>&1); then
        echo "warden: unknown for slot $n (coa-lab-mem warden-status failed: $json)"
        return 0
    fi
    enabled=$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["warden_enabled"])' "$json" 2>/dev/null) || true
    case "$enabled" in
        False)
            echo "warden: off on slot $n (coa-lab-mem usable)"
            ;;
        True)
            echo "WARN: slot $n has Warden.Enabled != 0: coa-lab-mem refuses every memory read on this" \
                 "slot's client (its own guard, see scripts/coa-lab-mem's docstring) until Warden is off." \
                 "coa-lab-packets reads the server's own packet log and has no Warden check."
            ;;
        *)
            echo "warden: unknown for slot $n ($(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("detail", ""))' "$json" 2>/dev/null))"
            ;;
    esac
}

cmd_start() {
    local n="${1:-}" auth pid display window waited
    [[ "$n" =~ ^[1-9][0-9]*$ ]] || die "usage: coa-client-lab start N (a coa-slot slot number)"
    [[ "$PROFILE" == readable || "$PROFILE" == minimal ]] || die "COA_LAB_PROFILE must be readable or minimal"
    [[ "$DISPLAY_MODE" == nested || "$DISPLAY_MODE" == headless ]] || die "COA_LAB_DISPLAY must be nested or headless"
    [[ "$WIDTH$HEIGHT$FPS" =~ ^[0-9]+$ ]] || die "COA_LAB_WIDTH, COA_LAB_HEIGHT and COA_LAB_FPS must be numbers"
    [[ -z "$INSTANCE" || -e "$INSTANCE_DIR/.coa-client-lab" ]] || die "no instance $INSTANCE: coa-client-lab create-instance"
    [[ -f "$LAB_CLIENT/Ascension.exe" ]] || die "no lab client: coa-client-lab create"
    # Paths go inside a Lua long string and a single-quoted bash -c: refuse characters that would break them.
    [[ "$LAB_CLIENT$LAB_PREFIX$PROTON$STATE_DIR" != *[[:space:]\'\]]* ]] || die "lab paths contain spaces, quotes or ]"
    auth=$(coa-slot env "$n" | sed -n 's/^AUTH_ADDR=//p')
    [[ -n "$auth" ]] || die "coa-slot env $n gave no AUTH_ADDR"
    mkdir -p "$STATE_DIR"
    if ! (set -o noclobber; echo "slot $n since $(date -Is)" > "$LOCK") 2>/dev/null; then
        die "lab client held: $(cat "$LOCK")"
    fi
    rm -f "$STATE_DIR/gamescope.pid" "$STATE_DIR/display" "$STATE_DIR/window" "$STATE_DIR/gamescope.starttime"
    touch "$STATE_DIR/started"
    echo "$n" > "$STATE_DIR/slot"
    if [[ "$(awk 'NR == 1 { print $3 }' "$STATE_DIR/preflight" 2>/dev/null)" != "$n" ]]; then
        rm -f "$STATE_DIR/preflight"
    fi
    # Recorded so a later restart_client (possibly a different script invocation, e.g. a `login` with an
    # account switch, with none of these variables in its own environment) launches with the settings this
    # start actually used, not whatever COA_LAB_PROFILE/COA_LAB_DISPLAY/COA_LAB_WIDTH/HEIGHT/FPS its own
    # caller happens to have (or not have). See docs/adr/0015-lab-restart-keeps-start-profile.md.
    printf 'PROFILE=%s\nDISPLAY_MODE=%s\nWIDTH=%s\nHEIGHT=%s\nFPS=%s\n' \
        "$PROFILE" "$DISPLAY_MODE" "$WIDTH" "$HEIGHT" "$FPS" > "$STATE_DIR/profile"
    warden_status_line "$n"

    apply_profile
    set_wtf "$LAB_CLIENT/WTF/Config.wtf" realmList "$auth"
    printf 'set realmlist %s\r\n' "$auth" > "$LAB_CLIENT/Data/enUS/realmlist.wtf"
    rm -rf "$LAB_CLIENT/Cache"
    # The client only loads addon folders present at launch.
    rm -rf "$LAB_CLIENT/Interface/AddOns/CoaProbe"
    cp -r "$ADDON_SRC" "$LAB_CLIENT/Interface/AddOns/CoaProbe"
    rm -rf "$LAB_CLIENT/Interface/AddOns/CoaProbe/tests"

    # A dedicated null sink: the client's own sound settings are rewritten on exit and its streams only appear once
    # the game has loaded, so muting afterwards is a race. Sending it to a sink nobody listens to is not.
    if command -v pactl > /dev/null && ! pactl list short sinks | grep -q "$SILENT_SINK"; then
        pactl load-module module-null-sink sink_name="$SILENT_SINK" > /dev/null || true
    fi
    local env="PULSE_SINK=$SILENT_SINK WINEPREFIX=$LAB_PREFIX GAMEID=0 PROTONPATH=$PROTON WINEDLLOVERRIDES=divxtac=d,winepulse.drv=d,winealsa.drv=d,winecoreaudio.drv=d,wineoss.drv=d"
    local size="-W $WIDTH -H $HEIGHT -w $WIDTH -h $HEIGHT"
    if [[ "$DISPLAY_MODE" == headless ]]; then
        step "Launching the lab client headless (${WIDTH}x${HEIGHT}, $FPS fps, profile $PROFILE) for slot $n ($auth)"
        setsid -f bash -c "echo \$\$ > $STATE_DIR/gamescope.pid && cd $LAB_CLIENT && exec env $env gamescope --backend headless $size -r $FPS -- umu-run Ascension.exe >>$STATE_DIR/client.log 2>&1" \
            < /dev/null > /dev/null 2>&1
    else
        step "Launching the lab client on workspace $WORKSPACE (${WIDTH}x${HEIGHT}, profile $PROFILE) for slot $n ($auth)"
        local cmd="bash -c 'echo \$\$ > $STATE_DIR/gamescope.pid && cd $LAB_CLIENT && exec env $env gamescope $size -- umu-run Ascension.exe >>$STATE_DIR/client.log 2>&1'"
        hyprctl eval "hl.exec_cmd([[$cmd]], { workspace = \"$WORKSPACE silent\" })" > /dev/null
    fi

    # Discovery reads the PID we just wrote via `echo $$` above directly, not through gamescope_pid.
    # gamescope.starttime is written below as soon as that PID is confirmed alive, once, before display
    # and window discovery: if the window is never found (die below) or start is interrupted, the file
    # stays behind so `stop` still recognises and kills the live gamescope tree (I-A).
    local starttime_recorded=0
    for ((waited = 0; waited < WINDOW_TIMEOUT; waited++)); do
        if pid=$(cat "$STATE_DIR/gamescope.pid" 2>/dev/null) && [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
            if [[ "$starttime_recorded" == 0 ]]; then
                gamescope_starttime "$pid" > "$STATE_DIR/gamescope.starttime" \
                    || die "cannot read the start time of gamescope pid $pid"
                starttime_recorded=1
            fi
            if display=$(find_display "$pid") \
                && window=$(DISPLAY="$display" xdotool search --name '^Ascension$' 2>/dev/null | head -1) \
                && [[ -n "$window" ]]; then
                echo "$display" > "$STATE_DIR/display"
                echo "$window" > "$STATE_DIR/window"
                echo "lab client window $window on display $display (gamescope pid $pid)"
            cmd_mute || true
                return 0
            fi
        fi
        sleep 1
    done
    die "no client window after ${WINDOW_TIMEOUT}s, see $STATE_DIR/client.log; then: coa-client-lab stop"
}

# Mute only this lab client's audio streams. The in-game sound settings are rewritten by the client on exit and
# umu-run resets WINEDLLOVERRIDES, so the reliable place is the sound server, matched by process id so the user's
# own client is never touched.
cmd_mute() {
    local pid tree ids id stream_pid
    command -v pactl > /dev/null || { echo "pactl not installed: cannot mute"; return 0; }
    pid=$(gamescope_pid) || die "the lab client is not running"
    tree=" $(descendants "$pid" | tr '\n' ' ') "
    ids=$(pactl list sink-inputs | awk '/^Sink Input #/ { id = substr($3, 2) } /application.process.id = / { gsub(/"/, "", $3); print id, $3 }') || true
    while read -r id stream_pid; do
        [[ -n "$id" ]] || continue
        if [[ "$tree" == *" $stream_pid "* ]]; then
            pactl set-sink-input-mute "$id" 1 && echo "muted sink input $id (pid $stream_pid)"
        fi
    done <<< "$ids"
}

cmd_status() {
    local pid
    if [[ ! -e "$LOCK" ]]; then
        echo "not running"
        return 0
    fi
    echo "lock: $(cat "$LOCK")"
    if pid=$(gamescope_pid); then
        echo "gamescope: running (pid $pid)"
    else
        echo "gamescope: not running (stale lock: coa-client-lab stop)"
    fi
    echo "display: $(cat "$STATE_DIR/display" 2>/dev/null || echo unknown)"
    echo "window: $(cat "$STATE_DIR/window" 2>/dev/null || echo unknown)"
}

cmd_type() {
    [[ $# -eq 1 ]] || die "usage: coa-client-lab type TEXT"
    require_running
    xdotool type --window "$WINDOW" --delay 40 "$1"
}

cmd_key() {
    [[ $# -ge 1 ]] || die "usage: coa-client-lab key KEY..."
    require_running
    xdotool key --window "$WINDOW" "$@"
}

cmd_chat() {
    [[ $# -eq 1 ]] || die "usage: coa-client-lab chat TEXT"
    require_running
    xdotool key --window "$WINDOW" Return
    "$SLEEP" 0.5
    xdotool type --window "$WINDOW" --delay 40 "$1"
    xdotool key --window "$WINDOW" Return
}

# Builds a go.work that supplies the only user-specific path (GHOST_REPO) as a `replace`, instead of
# baking it into lab-character/go.mod (go help work: go.work replace directives take precedence and are
# meant for exactly this; go.mod itself keeps only the public detour-go replace AzerothGhost also needs).
# GOSUMDB=off/GOPROXY=off: every module here is either this local replace or already in the module
# cache from building this package; no network fetch is expected, and none is attempted.
run_lab_character() {
    [[ -f "$GHOST_REPO/go.mod" ]] || die "no Ghost checkout at $GHOST_REPO (set COA_GHOST_REPO): no go.mod there"
    local workfile status=0
    workfile=$(mktemp --suffix=.work)
    printf 'go 1.26\n\nuse %s\n\nreplace github.com/azerothcore/AzerothGhost => %s\n' \
        "$LAB_CHARACTER_DIR" "$GHOST_REPO" > "$workfile"
    # `|| status=$?`, not a bare statement then `status=$?` on the next line: under this script's
    # `set -e`, a bare failing command exits the whole script before that next line ever runs.
    ( cd "$LAB_CHARACTER_DIR" && GOSUMDB=off GOPROXY=off GOWORK="$workfile" go test "$@" ) || status=$?
    rm -f "$workfile"
    return "$status"
}

# Mirrors DeriveAccount in scripts/lab-character (character_test.go): a dedicated lab account for
# one character, so `login CHARACTER` never has to pick from a character list. MAX_ACCOUNT_LEN=17
# is MAX_ACCOUNT_STR (src/server/game/Accounts/AccountMgr.h:34), the length
# AccountMgr::CreateAccount/ChangeUsername refuse past. LAB_ACCOUNT_PREFIX must match the server
# repo's CoA.ProbeRelay.AccountPrefix default ("COALAB"; src/server/coa/CoAProbeRelay.cpp), since
# only an account starting with it can be probed through the relay (docs/design/client-lab-level3.md).
# Character names are already validated as letters-only (`^[A-Za-z]+$` below), so the derived
# account is letters-only too.
LAB_ACCOUNT_PREFIX="COALAB"
MAX_ACCOUNT_LEN=17
derive_account() {
    local character="$1" upper derived
    upper=$(tr '[:lower:]' '[:upper:]' <<<"$character")
    derived="${LAB_ACCOUNT_PREFIX}${upper}"
    echo "${derived:0:$MAX_ACCOUNT_LEN}"
}

# Path of the generated password for a dedicated lab account (lower-cased, as asked). Never printed;
# callers read its content directly.
lab_password_file() {
    local account="$1" lower
    lower=$(tr '[:upper:]' '[:lower:]' <<<"$account")
    echo "$LAB_ROOT/secrets/${lower}.password"
}

# Generates a random password for a dedicated lab account on first use and reuses it afterwards, so
# a later `character` or `login` call for the same character gets back the same password. mode 600,
# never echoed by this function; alnum only (hex) so it types cleanly through xdotool.
ensure_lab_password() {
    local account="$1" file
    file=$(lab_password_file "$account")
    mkdir -p "$(dirname "$file")"
    if [[ ! -f "$file" ]]; then
        ( umask 077 && openssl rand -hex 16 > "$file" )
    fi
    chmod 600 "$file"
    cat "$file"
}

# Resolves the relay configuration file for SLOT (L14b: `relay.env` used to be one file under $LAB_ROOT
# shared by every slot and every lab instance, so `relay-setup` on one slot silently broke another
# session's relay on a different slot -- reports/l14-lab-fixes.md Concern 1). `relay-setup N` now writes
# $LAB_ROOT/relay/slotN.env instead, tried first; a pre-existing shared $LAB_ROOT/relay.env is still read
# (never rewritten, never deleted, never moved by this script) when its own SLOT line matches, so a setup
# from before this change keeps working without rerunning relay-setup. Echoes the resolved path and
# returns 0 on a match; prints nothing and returns 1 for an empty/unknown slot or no match either way.
relay_env_for_slot() {
    local slot="$1" candidate
    [[ -n "$slot" ]] || return 1
    candidate="$LAB_ROOT/relay/slot${slot}.env"
    if [[ -f "$candidate" ]]; then
        printf '%s\n' "$candidate"
        return 0
    fi
    if [[ -f "$LAB_ROOT/relay.env" ]] \
        && [[ "$(sed -n 's/^SLOT=//p' "$LAB_ROOT/relay.env")" == "$slot" ]]; then
        printf '%s\n' "$LAB_ROOT/relay.env"
        return 0
    fi
    return 1
}

# Grants RBAC_PERM_INSTANT_LOGOUT (id 1, src/server/game/Accounts/RBAC.h:52) to a lab account over the
# lab SOAP relay (`.rbac account grant ACCOUNT 1`, src/server/scripts/Commands/cs_rbac.cpp:85-117). This
# is the only effective use of that permission found in the server source (grepped: a single read site,
# src/server/game/Handlers/MiscHandler.cpp:535-536, HandleLogoutRequestOpcode) -- it only widens the
# existing `instantLogout` condition (already true while resting or in flight) so `/logout`/`/camp`
# always skips the normal 20s delay and calls `LogoutPlayer(true)` immediately, in the same world
# session, with no `.kick`/new-auth/duplicate-session path involved (L12 idea, proven against source,
# not a prior report's assumption). Idempotent: `.rbac account grant` reports success both the first time
# (acore_string 74, "Granted permission ...") and every time after (acore_string 72, "... already has
# that permission"); both count as success here. Refuses any account that is not COALAB* (lab accounts
# only, never a real player account) regardless of caller. Non-fatal to the caller by design (returns 1,
# does not `die`): a slot without relay-setup yet should not block `character` from creating the account.
# SLOT, when given (cmd_character already knows its own --slot before any `start`/STATE_DIR/slot exists
# for it), picks the relay file directly; otherwise falls back to the running instance's own slot
# (STATE_DIR/slot, written by `start`), same as every other reader below (L14b).
grant_instant_logout_rbac() {
    local account="$1" slot="${2:-}" out upper relay_env
    upper=$(tr '[:lower:]' '[:upper:]' <<<"$account")
    if [[ "$upper" != "${LAB_ACCOUNT_PREFIX}"* ]]; then
        echo "WARN: refusing to grant RBAC_PERM_INSTANT_LOGOUT to $account: not a $LAB_ACCOUNT_PREFIX*" \
             "lab account; it keeps the normal 20s /logout delay" >&2
        return 1
    fi
    [[ -n "$slot" ]] || slot=$(cat "$STATE_DIR/slot" 2>/dev/null) || slot=""
    if ! relay_env=$(relay_env_for_slot "$slot"); then
        echo "WARN: no relay configuration for slot ${slot:-unknown} (coa-client-lab relay-setup" \
             "${slot:-N} ...): RBAC_PERM_INSTANT_LOGOUT not granted to $account; /logout will keep the" \
             "normal 20s delay for it" >&2
        return 1
    fi
    out=$(COA_LAB_RELAY_ENV="$relay_env" "$RELAY" soap "rbac account grant $account 1" 2>&1) || {
        echo "WARN: rbac grant for $account failed: $out" >&2
        return 1
    }
    if [[ "$out" == *"Granted permission"* || "$out" == *"already has that permission"* ]]; then
        return 0
    fi
    echo "WARN: rbac grant for $account: unexpected relay output: $out" >&2
    return 1
}

cmd_character() {
    local slot="" account="" character="" race="" class="" level="0" spec="0" gm="0" learn="" items="" bag_items=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --slot) slot="${2:-}"; shift 2 ;;
            --account) account="${2:-}"; shift 2 ;;
            --character) character="${2:-}"; shift 2 ;;
            --race) race="${2:-}"; shift 2 ;;
            --class) class="${2:-}"; shift 2 ;;
            --level) level="${2:-}"; shift 2 ;;
            --spec) spec="${2:-}"; shift 2 ;;
            --gm) gm="${2:-}"; shift 2 ;;
            --learn) learn="${2:-}"; shift 2 ;;
            --items) items="${2:-}"; shift 2 ;;
            --bag-items) bag_items="${2:-}"; shift 2 ;;
            *) die "unknown character argument: $1" ;;
        esac
    done
    [[ "$slot" =~ ^[1-9][0-9]*$ ]] \
        || die "usage: coa-client-lab character --slot N [--account A] --character C --race R --class K [--level N] [--spec ID] [--gm N] [--learn ID,ID,...] [--items ID,ID,...] [--bag-items ID,ID,...]"
    [[ -n "$character" && -n "$race" && -n "$class" ]] \
        || die "character needs --character --race --class (and --account for a shared account)"
    [[ "$character" =~ ^[A-Za-z]+$ ]] || die "character names are letters only, got: $character"
    [[ "$class" =~ ^[0-9]+$ ]] && ((class >= 12 && class <= 32)) \
        || die "class must be a CoA class id 12-32 (CLASS_BARBARIAN..CLASS_SPIRIT_MAGE), got: $class"
    [[ "$race" =~ ^[0-9]+$ ]] || die "race must be a numeric race id, got: $race"
    [[ "$level" =~ ^[0-9]+$ ]] || die "level must be a number, got: $level"
    [[ "$spec" =~ ^[0-9]+$ ]] || die "spec must be a number, got: $spec"
    [[ "$gm" =~ ^[0-9]+$ ]] || die "gm must be a number, got: $gm"

    # Without --account, this character gets its own dedicated account (derive_account), with a
    # generated, reused password (ensure_lab_password): `login CHARACTER` alone can then resolve
    # both without ever picking from a character list. With --account, the named shared account gets
    # the same treatment (L9): its password is generated/reused the same way through
    # ensure_lab_password and passed to the harness, so EnsureAccount (e2eharness/db.go) always
    # updates the account's real DB password (salt/verifier) to match the secret, even when the
    # account already existed with a different password. This is what lets `login --account NAME
    # CHARACTER` read back a password that is actually valid. TestLabCharacterApply also reports the
    # account's full character list so this command can warn when it holds 2+ characters.
    local dedicated=0 password=""
    if [[ -z "$account" ]]; then
        account=$(derive_account "$character")
        dedicated=1
    fi
    password=$(ensure_lab_password "$account")
    grant_instant_logout_rbac "$account" "$slot" \
        || echo "WARN: $character's account ($account) may still see the normal 20s /logout delay" >&2

    local ghost_env
    ghost_env=$(coa-slot env "$slot" | sed -n 's/^GHOST_ENV=//p')
    [[ -n "$ghost_env" && -f "$ghost_env" ]] || die "coa-slot env $slot gave no readable GHOST_ENV (coa-slot create $slot first?)"

    local spec_json
    spec_json=$(COA_LAB_CHARACTER_PASSWORD="$password" python3 -c '
import json, sys
import os
account, character, race, klass, level, spec, gm, learn, items, bag_items, dedicated = sys.argv[1:12]
password = os.environ["COA_LAB_CHARACTER_PASSWORD"]
def ids(s):
    return [int(x) for x in s.split(",") if x.strip()]
print(json.dumps({
    "account": account, "character": character, "race": int(race), "class": int(klass),
    "level": int(level), "spec": int(spec), "gm": int(gm), "learn": ids(learn), "items": ids(items), "bag_items": ids(bag_items),
    "password": password, "dedicated": dedicated == "1",
}))
' "$account" "$character" "$race" "$class" "$level" "$spec" "$gm" "$learn" "$items" "$bag_items" "$dedicated") \
        || die "could not build the character request"

    local out status=0
    out=$(mktemp)
    ( set -a; source "$ghost_env"; set +a
      export COA_LAB_CHARACTER_SPEC="$spec_json" COA_LAB_CHARACTER_OUT="$out"
      run_lab_character -run '^TestLabCharacterApply$' -v . ) || status=$?
    if [[ "$status" != 0 ]]; then
        rm -f "$out"
        die "character setup failed (go test output above)"
    fi
    cat "$out"
    if [[ "$dedicated" == 0 ]]; then
        local others
        others=$(python3 -c '
import json, sys
d = json.load(open(sys.argv[1]))
print(len(d.get("account_characters", [])))
' "$out" 2>/dev/null) || others=0
        if [[ "${others:-0}" -ge 2 ]]; then
            echo "WARN: account $account now holds $others characters; \`login --account $account" \
                "$character\` (or \`login $account PASSWORD $character\`) navigates to $character by" \
                "name only when lab-client memory is usable this session (select_character_via_memory)." \
                "Without memory, character-select navigation by name is not implemented" \
                "(select_character), and login lands on whichever character the client already has" \
                "highlighted. Give $character its own dedicated account (omit --account) if it" \
                "needs to be logged into by name without relying on memory." >&2
        fi
    fi
    rm -f "$out"
}

# The 0-based index of CHARACTER in ACCOUNT's glue character list (CHAR_SEL_ENUM order; see
# scripts/lab-character/character_test.go), or empty on any lookup failure (new character, no relay
# slot recorded, Ghost checkout missing): the caller then skips navigation and keeps the default
# highlighted character, exactly like before this change.
lab_character_index() {
    local account="$1" character="$2" slot ghost_env out status=0 index
    slot=$(cat "$STATE_DIR/slot" 2>/dev/null) || return 1
    [[ -n "$slot" ]] || return 1
    ghost_env=$(coa-slot env "$slot" 2>/dev/null | sed -n 's/^GHOST_ENV=//p') || return 1
    [[ -n "$ghost_env" && -f "$ghost_env" ]] || return 1
    out=$(mktemp)
    ( set -a; source "$ghost_env"; set +a
      export COA_LAB_CHARACTER_ACCOUNT="$account" COA_LAB_CHARACTER_NAME="$character" COA_LAB_CHARACTER_OUT="$out"
      run_lab_character -run '^TestLabCharacterIndex$' . ) > /dev/null 2>&1 || status=$?
    if [[ "$status" != 0 ]]; then
        rm -f "$out"
        return 1
    fi
    index=$(python3 -c 'import json,sys
d=json.load(open(sys.argv[1]))
print(d["index"] if d.get("found") else "")' "$out" 2>/dev/null)
    rm -f "$out"
    [[ -n "$index" ]] || return 1
    echo "$index"
}

# Navigates the character-select list to CHARACTER before the caller's "enter world" Return. `/run` is
# not available at the glue screen (no Lua console there) and mouse clicks are unreliable in gamescope
# (spike findings Q2), so the only verified input is keyboard: Up enough times to reach the top of the
# list. Up/Down WAS tried here (clamp-to-top then step down to the known index) and is disabled again:
# live on slot 2 (2026-10-26) the list turned out to wrap circularly, not clamp, so a fixed "many Up
# presses" is not a reliable way to reach a known absolute position without first knowing the current
# highlight. One run it even moved the highlight OFF the already-correct default character (observed via
# screenshot: default highlight was already the target, 30 Up (even, so a no-op on a 2-entry circular
# list) + 1 Down moved it to the other character) — actively worse than doing nothing. Left/Right arrow
# icons are visible next to Enter World in the real screenshot and may be the actual paging control
# instead of Up/Down; unconfirmed. Needs a redesigned approach (read the current highlight first, or
# confirm the real paging keys) before this does anything; until then it only looks up and reports.
select_character() {
    local account="$1" character="$2" index
    if ! index=$(lab_character_index "$account" "$character"); then
        echo "WARN: could not find $character in $account's character list; using the default highlighted character" >&2
        return 0
    fi
    echo "WARN: $character is at character-list index $index, but character-select navigation is not" \
        "implemented yet (see comment above); using the default highlighted character" >&2
}

# Runs `coa-lab-mem glue` and prints its JSON on success; prints nothing and returns non-zero on any failure
# (guard refusal, no python3, unexpected output) -- the caller's cue to fall back to the pixel-check path,
# never a hard error here.
glue_state() {
    [[ -x "$LAB_MEM" ]] && command -v python3 > /dev/null 2>&1 || return 1
    python3 "$LAB_MEM" glue 2> /dev/null
}

# Memory reports in_world about 9 s before the in-world UI takes input (measured live, slot 2,
# 2026-10-27: `probe ping` first answered 9 s after `glue --until in-world` returned, 4/4). A command
# typed in that window, such as the next login's /camp, is lost. login therefore returns only once
# the addon answers a relay ping, which needs the UI loaded; without a relay descriptor it keeps the
# memory signal alone.
# The server sometimes ends the new session while the character list is shown, after a zero-gap
# switch back to a shared account (slot 2, 2026-10-27: about 1 in 10 mixed switches; cause not
# established, see ADR 0011). A second login from the same client state failed the same way each
# time (3/3), so the retry restarts the client first. A login answered LOGIN_DISCONNECTED leaves the
# client on the login screen with the "disconnected" dialog, which the next attempt dismisses before
# typing, so that one is retried in place. Every other failure stops at once.
login_with_retry() {
    local attempt rc
    [[ "$LOGIN_ATTEMPTS" =~ ^[1-9][0-9]*$ ]] || die "COA_LAB_LOGIN_ATTEMPTS must be a positive number"
    for ((attempt = 1; ; attempt++)); do
        rc=0
        ( cmd_login "$@" ) || rc=$?
        [[ "$attempt" -lt "$LOGIN_ATTEMPTS" ]] || return "$rc"
        case "$rc" in
            "$LOGIN_DISCONNECTED_EXIT")
                echo "WARN: the server disconnected the client during character selection; restarting it and logging in again" >&2
                ( restart_client ) || return "$rc" ;;
            "$LOGIN_REJECTED_EXIT")
                echo "WARN: the login was answered LOGIN_DISCONNECTED; logging in again" >&2 ;;
            *) return "$rc" ;;
        esac
    done
}

wait_ui_ready() {
    local expected="${1:-}" answer=""
    [[ -f "$STATE_DIR/lab.json" ]] || return 0
    local deadline=$((SECONDS + UI_READY_WAIT))
    until answer=$("$RELAY" --descriptor "$STATE_DIR/lab.json" probe --timeout 2 ping 2> /dev/null); do
        if ((SECONDS >= deadline)); then
            echo "WARN: the in-world UI did not answer a relay ping within ${UI_READY_WAIT}s" >&2
            return 1
        fi
        "$SLEEP" 0.3
    done
    # L14 (problem 2): `login --account COALABKOX Wrkox` once entered the world as the account's other
    # character, Hfkox, with nothing noticing -- character-select navigation can fail silently and leave
    # the client's own default-highlighted character in world instead of the one asked for.
    # addons/CoaProbe/Relay.lua already stamps every relayed answer with `character = UnitName("player")`,
    # the in-world player's own name, independent of whichever name this ping was addressed to -- this is
    # the same ping this function already sent to confirm the UI is ready, read a second time instead of
    # a second round trip. A relay too old to carry that field (or the UI-ready probe answering before this
    # field existed) cannot be told apart from a genuine mismatch, so a missing field only warns; an actual
    # mismatch between `character` and the requested name is always a hard failure, not something a caller's
    # `wait_ui_ready || true` can swallow.
    [[ -n "$expected" ]] || return 0
    local actual
    actual=$(python3 -c '
import json, sys
try:
    print(json.loads(sys.argv[1]).get("character", ""))
except ValueError:
    print("")
' "$answer")
    if [[ -z "$actual" ]]; then
        echo "WARN: relay probe ping named no character after login (raw answer: $answer); cannot confirm" \
             "$expected is the one in world" >&2
        return 0
    fi
    [[ "${actual,,}" == "${expected,,}" ]] && return 0
    python3 -c '
import json, sys
path, actual = sys.argv[1:3]
with open(path, encoding="utf-8") as handle:
    descriptor = json.load(handle)
descriptor["character"] = actual
with open(path, "w", encoding="utf-8") as handle:
    json.dump(descriptor, handle, indent=2)
' "$STATE_DIR/lab.json" "$actual" || true
    die "logged in as the wrong character: requested $expected, the relay reports $actual is in world"
}

# Waits up to $2 seconds (the same fixed sleep this replaces, kept as an upper bound) for glue state $1
# (login|charselect|charselect-loaded|in-world) to hold, polling inside a single `coa-lab-mem glue --until`
# process (reports/l7: that process runs the guards once and polls internally at 0.1s, instead of this file
# spawning a fresh `coa-lab-mem glue` -- plus extra python3 field-parses -- on every tick, which is what cost
# ~1.5-3.5s per tick before every step of a login). Falls back to sleeping the full ceiling, unchanged, when
# `coa-lab-mem` is not usable at all (same fallback `wait_or_sleep` used for the same case). Prints the final
# JSON on success (0) or on a timeout (still prints the last state, exits 1) so a caller that also needs a
# field from it does not need another read; prints nothing only when coa-lab-mem itself could not run.
glue_until() {
    local state="$1" ceiling="$2"
    if [[ -x "$LAB_MEM" ]] && command -v python3 > /dev/null 2>&1; then
        python3 "$LAB_MEM" glue --until "$state" --timeout "$ceiling" 2> /dev/null
        return $?
    fi
    "$SLEEP" "$ceiling"
    return 1
}

# Reads one field (current_screen, in_world, selection_index) out of a `coa-lab-mem glue` JSON blob already
# captured in $1. Prints nothing if the blob is empty or the field is missing/unreadable.
glue_field() {
    local json="$1" field="$2"
    [[ -n "$json" ]] || return 0
    # json.load parses a JSON `false`/`true` into Python's `False`/`True`; printing it raw would give
    # "False"/"True" (capitalized), which never matches this file's own "false"/"true" string literals
    # (confirmed live, 2026-10-26: `in_world` always read back as "False", so `[[ "$world" == "true" ]]`
    # never matched even while genuinely in world, and the stale `current_screen` value -- left over
    # from before entering the world, see `GLUE_CURRENT_SCREEN`'s comment -- then coincidentally matched
    # the character-select branch below, so this command tried the "Back" click while still in the
    # world, without ever having sent /camp; every live attempt timed out and fell back to a restart).
    # Booleans are normalized to JSON's own spelling here so every caller's string comparison works.
    python3 -c '
import json, sys
try:
    value = json.load(sys.stdin).get(sys.argv[1], "")
    print(str(value).lower() if isinstance(value, bool) else value)
except Exception:
    pass
' "$field" <<< "$json" 2> /dev/null
}

# Clicks the character-select screen's "Back" button, at (0.943, 0.967) of the window (measured live,
# slot 2, 2026-10-26, 1024x768: pixel (966, 743)), as XTEST fake input to the active window. The
# XSendEvent form (`mousemove --window ... click`) failed 2/2 in L5 and 4/4 in L3/ADR 0003 when driven
# from inside this script's process; this form registered 3/3 (L6, ADR 0005). Why is not established.
click_charselect_back_xtest() {
    xtest_click_pct 943 967
}

# Shared XTEST click (activate the window, then mousemove/click with no --window), proportional to the
# window's current size. Used for every click this script drives from inside its own process (as opposed
# to a separate `coa-client-lab` invocation): see click_charselect_back_xtest's own history above for why
# this form, not XSendEvent (mousemove --window ... click), is the one proven reliable here.
xtest_click_pct() {
    local xpct="$1" ypct="$2" geometry
    geometry=$(xdotool getwindowgeometry --shell "$WINDOW") || return 1
    eval "$geometry"
    xdotool windowactivate --sync "$WINDOW" || return 1
    xdotool mousemove --sync $((WIDTH * xpct / 1000)) $((HEIGHT * ypct / 1000)) || return 1
    xdotool click 1
}

# Dismisses a leftover "You have been disconnected from the server" dialog's "Okay" button (reports/l8,
# live, slot 2, 2026-10-26: measured at (0.5, 0.517) of width/height, 1024x768 -- the same point
# `cmd_login`'s own account-field click already uses, (width/2, height*315/600 = 0.525); clicking it is
# harmless on a dialog-free login screen too, since that click is exactly the one `cmd_login` sends next to
# focus the account field, so this never corrupts a screen that had no dialog).
click_login_dialog_dismiss() {
    xtest_click_pct 500 517
}

# L13 (2026-10-27, slot 2, live): a SECOND, custom "Project Descension - Connection Help" popup (this
# client's own addon, not a Blizzard StaticPopup) appears on a genuine connection drop and shares
# current_screen=="login" with a clean login screen, same as the dialog above -- but it is a much larger
# panel and its own "Okay" button sits at approx (0.697, 0.792) of the window (measured live, 1024x768:
# (714, 608)), well outside click_login_dialog_dismiss's (0.5, 0.517) point, which lands inside this
# panel's body text and does nothing. Reproduced twice in this session (screenshots 05:44 and 06:05): once
# shown, every later `login` call kept failing or misreporting until this point was clicked by hand. Same
# harmlessness precedent as click_login_dialog_dismiss: on a clean login screen (1024x768) this point sits
# in empty background between the Login and Quit buttons (confirmed live against a dialog-free screenshot),
# so calling it unconditionally alongside the dialog above is not expected to corrupt a clean screen.
click_connection_help_dismiss() {
    xtest_click_pct 697 792
}

# The character this session last wrote to `state/lab.json` (cmd_login's own write_descriptor, called only
# after reaching world): the one `kick_via_soap` below needs to name, read without ever invoking a
# `coa-lab-relay probe` round trip. Empty, not an error, when no login has reached world yet this session.
lab_last_character() {
    [[ -f "$STATE_DIR/lab.json" ]] || return 0
    python3 -c '
import json, sys
try:
    print(json.load(open(sys.argv[1])).get("character", ""))
except Exception:
    pass
' "$STATE_DIR/lab.json" 2> /dev/null
}

# Ends a character's world session server-side over the lab SOAP relay (reports/l8: live, slot 2,
# 2026-10-26, ".kick CHARACTER" -> "Player CHARACTER kicked.", confirmed in memory within ~3s: in_world
# false, then current_screen "login" directly -- no character-select leg at all, unlike /camp).
#
# L11 (2026-10-27) found the actual cause of the "empty output" symptom reports/l8/l10 described (previously
# hidden: the relay call's stderr was discarded, `2>/dev/null`): under a truly zero-gap switch (this script's
# own back-to-back proof runs, 7/8 and 8/8 reproductions), the kick attempt made immediately after the
# *target* character's own world entry gets back the `.kick` command's own usage/syntax text, not a real
# argument error -- `HandleKickPlayerCommand` (src/server/scripts/Commands/cs_misc.cpp:1410-1418) returns
# `false` with no message whenever `target` does not resolve to a connected player, which AC's command
# dispatcher then reports as that command's syntax help; `ACSoap.cpp`'s `ns1__executeCommand` turns any
# `false` return into a SOAP fault carrying that same text (ACSoap.cpp:140-146). This reads as a short-lived
# server-side name/connected-flag registration race in the ~1-2s right after that character's own world
# entry: the same `kick CHARACTER` call, made again a few seconds later with nothing else changed, always
# succeeded in every reproduction this session. The previous 1-attempt-after-1s retry does not clear this
# window reliably (observed failing on both attempt 1 at t+0s and attempt 2 at t+1.0s); KICK_RETRY_ATTEMPTS
# and KICK_RETRY_WAIT widen it to as many attempts as that many seconds, still far cheaper than the ~45s
# restart fallback this replaces when it lands. Advisory like every other memory/relay use in this script: no
# relay configuration for this slot (no relay-setup yet; L14b: STATE_DIR/slot names the slot, relay_env_for_slot
# resolves its file), an unknown character, or a kick still unsuccessful after every attempt falls back to the
# caller's /camp path (and from there to restart_client) instead of being treated as a hard failure.
KICK_RETRY_WAIT="${COA_LAB_KICK_RETRY_WAIT:-1}"
KICK_RETRY_ATTEMPTS="${COA_LAB_KICK_RETRY_ATTEMPTS:-4}"
kick_via_soap() {
    local character="$1" slot="${2:-}" out err attempt relay_env
    [[ -n "$slot" ]] || slot=$(cat "$STATE_DIR/slot" 2>/dev/null) || slot=""
    relay_env=$(relay_env_for_slot "$slot") || return 1
    [[ -n "$character" ]] || return 1
    for ((attempt = 1; attempt <= KICK_RETRY_ATTEMPTS; attempt++)); do
        err=$(mktemp)
        out=$(COA_LAB_RELAY_ENV="$relay_env" "$RELAY" soap "kick $character" 2> "$err") || out=""
        if [[ "$out" == *kicked* ]]; then
            rm -f "$err"
            return 0
        fi
        if [[ -s "$err" ]]; then
            echo "kick_via_soap: attempt $attempt for $character: $(cat "$err")" >&2
        elif [[ -z "$out" ]]; then
            echo "kick_via_soap: attempt $attempt for $character: empty output, no stderr" >&2
        fi
        rm -f "$err"
        [[ "$attempt" -lt "$KICK_RETRY_ATTEMPTS" ]] && "$SLEEP" "$KICK_RETRY_WAIT"
    done
    return 1
}

# 0 dead, 1 alive, 2 unknown (no probe answer): the addon's own view, which still answers while the
# character is dead and the chat box refuses every input.
lab_player_dead() {
    local out
    out=$(cmd_probe state 2> /dev/null) || return 2
    python3 -c '
import json, sys
try:
    sys.exit(0 if json.load(sys.stdin)["result"]["player"].get("dead") else 1)
except Exception:
    sys.exit(2)
' <<<"$out"
}

cmd_revive() {
    [[ $# -le 1 ]] || die "usage: coa-client-lab revive [CHARACTER]"
    local character="${1:-}" slot relay_env attempt dead
    [[ -n "$character" ]] || character=$(lab_last_character)
    [[ -n "$character" ]] || die "revive needs CHARACTER: no login has reached world this session"
    slot=$(cat "$STATE_DIR/slot" 2> /dev/null) || slot=""
    relay_env=$(relay_env_for_slot "$slot") || die "no relay configuration for slot ${slot:-unknown}: run relay-setup first"
    for attempt in 1 2; do
        COA_LAB_RELAY_ENV="$relay_env" "$RELAY" soap "revive $character" || die "revive $character failed"
        "$SLEEP" 2
        lab_player_dead && dead=1 || dead=0
        if [[ "$dead" == 0 ]]; then
            echo "revived $character"
            return 0
        fi
        if [[ "$attempt" == 1 ]]; then
            echo "$character is still dead after revive: releasing the spirit (CMSG_REPOP_REQUEST), then reviving again" >&2
            cmd_probe pksend 346 u8:0 > /dev/null 2>&1 || true
            "$SLEEP" 2
        fi
    done
    die "$character is still dead after revive and release"
}

cmd_erase() {
    local character="" account="" slot="" relay_env soap_account upper
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --account) account="${2:-}"; shift 2 ;;
            --slot) slot="${2:-}"; [[ "$slot" =~ ^[0-9]+$ ]] || die "--slot needs a slot number"; shift 2 ;;
            -*) die "usage: coa-client-lab erase CHARACTER [--account A] [--slot N]" ;;
            *) [[ -z "$character" ]] || die "usage: coa-client-lab erase CHARACTER [--account A]"; character="$1"; shift ;;
        esac
    done
    [[ "$character" =~ ^[A-Za-z]{2,12}$ ]] || die "usage: coa-client-lab erase CHARACTER [--account A] [--slot N] (CHARACTER: 2-12 letters)"
    [[ -n "$slot" ]] || slot=$(cat "$STATE_DIR/slot" 2> /dev/null) || slot=""
    relay_env=$(relay_env_for_slot "$slot") || die "no relay configuration for slot ${slot:-unknown}: run relay-setup first, or pass --slot N when the lab client is stopped"
    soap_account=$(sed -n 's/^SOAP_ACCOUNT=//p' "$relay_env")
    local delete_account=1
    if [[ -n "$account" ]]; then
        delete_account=0
    else
        account=$(derive_account "$character")
    fi
    upper=$(tr '[:lower:]' '[:upper:]' <<<"$account")
    [[ "$upper" == "${LAB_ACCOUNT_PREFIX}"* ]] || die "refusing to touch $account: not a $LAB_ACCOUNT_PREFIX* lab account"
    [[ "$upper" != "$(tr '[:lower:]' '[:upper:]' <<<"$soap_account")" ]] || die "refusing to touch $account: it is the relay's SOAP account"
    local info owner
    info=$(COA_LAB_RELAY_ENV="$relay_env" "$RELAY" soap "pinfo $character") || die "cannot look up $character on the relay"
    owner=$(sed -n 's/.*Account: \([^ ]*\) (ID: [0-9]*).*/\1/p' <<<"$info" | head -n 1)
    [[ "$(tr '[:lower:]' '[:upper:]' <<<"$owner")" == "$upper" ]] \
        || die "refusing to erase $character: it belongs to account ${owner:-unknown}, not $upper"
    COA_LAB_RELAY_ENV="$relay_env" "$RELAY" soap "character erase $character" || die "character erase $character failed"
    if [[ "$delete_account" == 1 ]]; then
        COA_LAB_RELAY_ENV="$relay_env" "$RELAY" soap "account delete $account" || die "account delete $account failed"
        rm -f "$(lab_password_file "$account")"
        echo "erased $character and deleted account $upper"
    else
        echo "erased $character; account $upper kept"
    fi
}

camera_status() {
    cmd_probe eval 'GetCVar("cameraSavedPitch").."/"..GetCVar("cameraSavedDistance")' 2> /dev/null | python3 -c '
import json, sys
try:
    pitch, distance = json.load(sys.stdin)["result"]["values"][0].split("/")
    print("camera pitch %.1f degrees, distance %.2f yards" % (float(pitch), float(distance)))
except Exception:
    sys.exit(1)
'
}

cmd_camera() {
    local axis="${1:-}" direction="${2:-}" ms="${3:-}" move seconds
    local usage="usage: coa-client-lab camera status | reset | pitch up|down MS | yaw left|right MS | zoom in|out MS"
    case "$axis" in
        status) camera_status || die "no camera reading from the probe"; return ;;
        reset)
            cmd_chat "/script ResetView(3) SetView(3)"
            "$SLEEP" 4
            camera_status || true
            return ;;
    esac
    [[ "$ms" =~ ^[0-9]+$ ]] || die "$usage"
    case "$axis $direction" in
        "pitch up") move=ViewUp ;;
        "pitch down") move=ViewDown ;;
        "yaw left") move=ViewLeft ;;
        "yaw right") move=ViewRight ;;
        "zoom in") move=ViewIn ;;
        "zoom out") move=ViewOut ;;
        *) die "$usage" ;;
    esac
    seconds=$(awk -v ms="$ms" 'BEGIN { print ms / 1000 }')
    cmd_chat "/script local e=0 local f=CreateFrame(\"Frame\") Move${move}Start() f:SetScript(\"OnUpdate\",function(s,dt) e=e+dt if e>=$seconds then Move${move}Stop() s:SetScript(\"OnUpdate\",nil) end end)"
    "$SLEEP" "$(awk -v s="$seconds" 'BEGIN { print s + 2 }')"
    camera_status || true
}

# Position of the character from `.gps`, read back from the addon's capture of the system messages:
# "X Y Z ORIENTATION". Fails when no `.gps` answer shows up (a dead character cannot chat).
lab_gps() {
    cmd_chat ".gps"
    "$SLEEP" 2
    cmd_probe log 15 2> /dev/null | python3 -c '
import re, sys
text = sys.stdin.read()
found = re.findall(r"X: (-?[0-9.]+) Y: (-?[0-9.]+) Z: (-?[0-9.]+) Orientation: ([0-9.]+)", text)
if not found:
    sys.exit(1)
print(*found[-1])
'
}

# Reports where `.go xyz` really put the character: `.go xyz` silently floor-snaps heights, and a tight or
# airborne landing can kill the character (a dead character cannot chat, so the teleport is also lost).
goto_verify_landing() {
    local requested_z="$1" landed lx ly lz lo
    if lab_player_dead; then
        echo "WARN: the character died on landing (tight collision or a fall): reviving; try another --bearing, --distance or --dz" >&2
        cmd_revive || true
    fi
    if landed=$(lab_gps); then
        read -r lx ly lz lo <<<"$landed"
        echo "landed at $lx $ly $lz (orientation $lo)"
        if awk -v a="$lz" -v b="$requested_z" 'BEGIN { d = a - b; exit !(d > 2 || d < -2) }'; then
            echo "WARN: landed at Z $lz, not the requested $requested_z: the server snaps .go xyz heights to the ground and a landing in rock or off the map drops the character; read the position back before trusting the view" >&2
        fi
    else
        echo "WARN: no .gps answer: the landing position could not be read back" >&2
    fi
}

cmd_goto_spawn() {
    local kind="${1:-}" entry="" guid="" distance=8 bearing=0 dz=0 slot db_container table id_column key value row
    [[ "$kind" == gameobject || "$kind" == creature ]] || die "usage: coa-client-lab goto-spawn gameobject|creature (--entry ID | --guid ID) [--distance YD] [--bearing DEG] [--dz YD]"
    shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --entry) entry="${2:-}"; shift 2 ;;
            --guid) guid="${2:-}"; shift 2 ;;
            --distance) distance="${2:-}"; shift 2 ;;
            --bearing) bearing="${2:-}"; shift 2 ;;
            --dz) dz="${2:-}"; shift 2 ;;
            *) die "unknown goto-spawn argument: $1" ;;
        esac
    done
    [[ -n "$entry" || -n "$guid" ]] || die "goto-spawn needs --entry ID or --guid ID"
    [[ -z "$entry" || -z "$guid" ]] || die "goto-spawn takes --entry or --guid, not both"
    [[ "${entry:-$guid}" =~ ^[0-9]+$ ]] || die "goto-spawn ids are numbers"
    [[ "$distance" =~ ^[0-9]+(\.[0-9]+)?$ && "$bearing" =~ ^-?[0-9]+(\.[0-9]+)?$ && "$dz" =~ ^-?[0-9]+(\.[0-9]+)?$ ]] \
        || die "--distance, --bearing and --dz must be numbers"
    slot=$(cat "$STATE_DIR/slot" 2> /dev/null) || die "goto-spawn needs a started lab client (no slot recorded)"
    db_container=$(coa-slot env "$slot" | sed -n 's/^DATABASE_CONTAINER=//p')
    [[ -n "$db_container" ]] || die "coa-slot env $slot names no database container"
    if [[ "$kind" == gameobject ]]; then
        table=gameobject id_column=id
    else
        table=creature
        id_column=$(docker exec "$db_container" sh -c "mysql -uroot -p\"\$MYSQL_ROOT_PASSWORD\" -N -e \"select column_name from information_schema.columns where table_schema='acore_world' and table_name='creature' and column_name in ('id','id1') order by column_name desc limit 1\" 2> /dev/null") \
            || die "database query failed"
        [[ -n "$id_column" ]] || die "acore_world.creature has neither an id nor an id1 column"
    fi
    if [[ -n "$entry" ]]; then key="$id_column" value="$entry"; else key=guid value="$guid"; fi
    row=$(docker exec "$db_container" sh -c "mysql -uroot -p\"\$MYSQL_ROOT_PASSWORD\" -N -e \"select guid, map, position_x, position_y, position_z from acore_world.$table where $key = $value order by guid limit 1; select count(*) from acore_world.$table where $key = $value\" 2> /dev/null") \
        || die "database query failed"
    local spawn_guid map x y z count
    read -r spawn_guid map x y z <<<"$(sed -n 1p <<<"$row")"
    count=$(sed -n 2p <<<"$row")
    [[ -n "$spawn_guid" ]] || die "no $kind spawn with $key $value in acore_world.$table"
    local target
    target=$(python3 -c '
import math, sys
x, y, z, distance, bearing, dz = (float(v) for v in sys.argv[1:7])
rad = math.radians(bearing)
facing = (rad + math.pi) % (2 * math.pi)
print("%.3f %.3f %.3f %.4f" % (x + distance * math.cos(rad), y + distance * math.sin(rad), z + dz, facing))
' "$x" "$y" "$z" "$distance" "$bearing" "$dz")
    local tx ty tz facing
    read -r tx ty tz facing <<<"$target"
    echo "spawn $kind guid $spawn_guid map $map at $x $y $z ($count with $key $value; first used)"
    echo ".go xyz $tx $ty $tz $map $facing"
    if [[ "${COA_LAB_GOTO_VERIFY:-1}" == 1 ]] && lab_player_dead; then
        echo "WARN: the character is dead, so the teleport would be silently ignored: reviving first" >&2
        cmd_revive || die "cannot revive the dead character: the teleport would be lost"
    fi
    cmd_chat ".go xyz $tx $ty $tz $map $facing"
    [[ "${COA_LAB_GOTO_VERIFY:-1}" == 1 ]] || return 0
    "$SLEEP" 3
    goto_verify_landing "$tz"
}

# Returns 0 once memory confirms the account-login screen, driving the client there in place instead of
# restarting it. Three starting states, each confirmed by `glue_state` before anything is sent:
#   - already the login screen (current_screen == "login", in_world == false): nothing else runs.
#   - character-select (in_world == false, any other current_screen): click_charselect_back_xtest, confirmed
#     by a bounded poll (CHARSELECT_BACK_WAIT).
#   - in world (in_world == true): kick_via_soap first (reports/l8: lands on the login screen directly,
#     confirmed by a bounded poll (KICK_WAIT) plus a dismiss click, 3-5s total live vs. /camp's 2.6s-to-60s+
#     range under load -- see ADR 0007), confirmed by a bounded poll for character-select (CAMP_WAIT), then the
#     same character-select click as above.
# Any step that does not confirm within its bound returns 1, and the caller (cmd_login) falls back to
# restart_client, unchanged from ADR 0004 -- the client is never left in a state cmd_login cannot account
# for by this function alone returning 1.
CHARSELECT_BACK_WAIT="${COA_LAB_CHARSELECT_BACK_WAIT:-10}"
CAMP_WAIT="${COA_LAB_CAMP_WAIT:-15}"
KICK_WAIT="${COA_LAB_KICK_WAIT:-8}"
KICK_DIALOG_WAIT="${COA_LAB_KICK_DIALOG_WAIT:-3}"
DIALOG_DISMISS_WAIT="${COA_LAB_DIALOG_DISMISS_WAIT:-5}"
# L12: bound for /camp's own confirmation once the account holds RBAC_PERM_INSTANT_LOGOUT
# (grant_instant_logout_rbac): MiscHandler.cpp:535-536/567-571 calls LogoutPlayer(true) immediately
# instead of arming the normal 20s SetLogoutStartTime delay, so charselect-loaded should confirm in well
# under this, not up to CAMP_WAIT's 15s. Kept well above a single round trip to absorb client-side scene
# transition time (character-select load), not the server-side delay this permission removes.
INSTANT_LOGOUT_WAIT="${COA_LAB_INSTANT_LOGOUT_WAIT:-8}"

# True only for the one dialog trigger this session found a reliable memory signal for (L11, 2026-10-27):
# the client's OWN login attempt was rejected (wrong password, already online, a duplicate-session force
# disconnect during realm-connect, ...) -- current_screen == "login" and login_state == LOGIN_STATE_FAILED
# (5, WoW/Source/WowServices/Types.h:81). Validated live, slot 2, 2026-10-27, on the brief's own
# reproduction (a duplicate-session disconnect during a login attempt left the client on a "You have been
# disconnected from the server" dialog): login_state=5, login_result=21 (LOGIN_DISCONNECTED).
#
# This does NOT detect the *other* trigger for the same dialog text: an already-in-world client kicked
# (`.kick`, this script's own or anyone else's) or disconnected. Also tried live this session, same slot,
# same dialog (screenshot-confirmed both times): login_state read 16 (LOGIN_STATE_DISCONNECTED, the value
# already held while legitimately in world) on BOTH a kicked client showing the dialog AND a client that had
# just reached a genuinely clean login screen through the existing graceful `/camp` + Back-click recovery
# (screenshot-confirmed clean: Username field visible, no dialog) -- identical reading either way.
# disconnect_pending and showed_disconnect also both read 0 in the kicked-dialog case (edge-triggered,
# already consumed by the time the dialog is visible; see their own comments in coa-lab-mem). No field this
# session read distinguishes a kick-caused dialog from a clean login screen reached the same way. Not fixed
# here (not verified further, time budget); flagged for whoever investigates the dialog's own Lua/FrameXML
# state next (StaticPopup-style UI, likely tracked outside CGlueMgr entirely).
#
# A second finding (L11, same session): login_state does NOT reset when the dialog is dismissed -- it is
# sticky until the *next* real login/connect attempt changes it. Live-proven: a screenshot taken right after
# a successful Okay click showed a genuinely clean login screen (Username field visible, no dialog), while
# login_state still read 5. So login_state==5 is only ever used here as the pre-click "a failure was just
# recorded" signal (`glue_login_dialog_present`), never as a post-click success condition -- `coa-lab-mem
# glue`'s own `login-clean` --until state has the same limitation and is not used by either dismiss function
# below for that reason; both confirm only current_screen == "login" afterward, matching the pre-L11 code's
# own bar for this (no stronger memory-based confirmation exists for "the dialog is actually gone now").
glue_login_dialog_present() {
    local json
    json=$(glue_state) || return 1
    [[ "$(glue_field "$json" current_screen)" == "login" && "$(glue_field "$json" login_state)" == "5" ]]
}

# Clicks Okay (click_login_dialog_dismiss) only when memory confirms the detectable (login_state==5) case,
# then re-reads memory to confirm the account-login screen is still current (see the comment above for why
# not more than that). Used only at the one call site (cmd_login, just before typing) where an unconditional
# click was previously found to risk a regression (ADR 0007) and a narrower, proven-safe gate is preferred
# over an unconditional one.
dismiss_login_dialog_via_memory() {
    glue_login_dialog_present || return 0
    click_login_dialog_dismiss || return 1
    click_connection_help_dismiss || return 1
    glue_until login "$DIALOG_DISMISS_WAIT" > /dev/null
}

# Clicks Okay unconditionally, then confirms via memory that the account-login screen is (still) current.
# Not gated on glue_login_dialog_present: as documented above, that signal misses the kick-caused dialog,
# which is exactly what this function exists to clear. Safe to run even when no dialog is present --
# click_login_dialog_dismiss (0.5, 0.517 of the window) is the same point `cmd_login`'s own account-field
# click already uses next, proven harmless on a dialog-free login screen (ADR 0007) and re-confirmed live
# this session (clicked it on both a dialog-present and a dialog-free login screen; the clean screen stayed
# clean, screenshot-confirmed). This is "memory-driven, not blind" in the sense the brief asked for even
# though the click itself cannot be gated on proof of the dialog: the result is always reconfirmed by memory
# before the caller proceeds, never assumed.
clear_login_dialog_unconditionally() {
    click_login_dialog_dismiss || return 1
    # L13: also try the custom Connection-Help popup's own Okay button (see click_connection_help_dismiss);
    # current_screen alone cannot tell which dialog, if any, was showing, so both clicks always run.
    click_connection_help_dismiss || return 1
    glue_until login "$DIALOG_DISMISS_WAIT" > /dev/null
}

# Reaches character-select from world via /camp WITHOUT going on to the login screen, so cmd_login's
# same-account character switch can skip retyping credentials entirely. Needs RBAC_PERM_INSTANT_LOGOUT
# (grant_instant_logout_rbac): without it /camp arms the normal 20s delay instead of logging out at once
# (MiscHandler.cpp:535-536/567-571), so this function does not fall back to a longer wait or to
# kick_via_soap on its own -- a kick always lands on the login screen, not character-select (kick_via_soap's
# own comment), so it cannot serve this same-session fast path; a timeout here just means the caller falls
# back to the full goto_login_screen_via_memory recovery, which still logs the same character's account
# back in, just via the login screen instead of staying in-session. Already at character-select (not in
# world, not at the login screen) is a no-op success: nothing to log out of.
#
# L12 saw /camp reach charselect-loaded on only about 1 in 7-9 attempts. Cause, measured afterwards
# (slot 2, 2026-10-27): the previous login returned as soon as memory reported in_world, about 9 s
# before the in-world UI takes input, so this /camp was typed into the loading screen and lost.
# With login waiting for the UI (wait_ui_ready), 5/5 zero-gap same-account switches took this path.
goto_charselect_via_memory() {
    local json screen world
    json=$(glue_state) || return 1
    screen=$(glue_field "$json" current_screen)
    world=$(glue_field "$json" in_world)
    if [[ "$world" == "false" && -n "$screen" && "$screen" != "login" ]]; then
        return 0
    fi
    [[ "$world" == "true" ]] || return 1
    cmd_chat "/camp" || return 1
    glue_until charselect-loaded "$INSTANT_LOGOUT_WAIT" > /dev/null && return 0
    echo "WARN: /camp did not reach character-select within ${INSTANT_LOGOUT_WAIT}s; using the login screen" >&2
    return 1
}

goto_login_screen_via_memory() {
    local json screen world character
    json=$(glue_state) || return 1
    screen=$(glue_field "$json" current_screen)
    world=$(glue_field "$json" in_world)
    if [[ "$screen" == "login" && "$world" == "false" ]]; then
        clear_login_dialog_unconditionally
        return
    fi
    if [[ "$world" == "true" ]]; then
        # L12 tried making /camp itself (now instant via grant_instant_logout_rbac) the primary recovery
        # here too, ahead of kick_via_soap, on the theory that it would avoid kick's own server-side
        # session-registration race (that function's comment). Live, slot 2, 2026-10-27: the instant
        # /camp DID land on character-select quickly (confirmed: charselect-loaded within well under
        # INSTANT_LOGOUT_WAIT, even with a generous 25s bound to rule out a mere timeout), but the
        # Back-click + different-account relogin that follows it then reproducibly failed
        # (login_state=5/LOGIN_DISCONNECTED) every time tried (zero gap, a 2s pace, and a ~15s real gap
        # alike) -- a short settle sleep before the Back click did not fix it either. kick_via_soap's own
        # path (straight to the login screen, no charselect/Back leg) kept working in the same session
        # immediately after. Root cause not established (not verified further, time budget): something
        # about the graceful /camp->charselect->Back sequence specifically, not generic timing, breaks a
        # different-account relogin here. Reverted to L11's kick-first order for this path; the instant
        # permission's proven, tested use stays goto_charselect_via_memory's same-account fast path below
        # (cmd_login), which never reaches the login screen or clicks Back at all.
        character=$(lab_last_character) || character=""
        if [[ -n "$character" ]] && kick_via_soap "$character" \
            && glue_until login "$KICK_WAIT" > /dev/null; then
            dismiss_kick_dialog || return 1
            clear_login_dialog_unconditionally
            return
        fi
        cmd_chat "/camp"
        glue_until charselect-loaded "$CAMP_WAIT" > /dev/null || return 1
    elif [[ "$world" == "false" && -n "$screen" && "$screen" != "login" ]]; then
        : # already at character-select; fall through to the click below
    else
        return 1
    fi
    click_charselect_back_xtest || return 1
    glue_until login "$CHARSELECT_BACK_WAIT" > /dev/null || return 1
    clear_login_dialog_unconditionally
}

# At character-select, presses Down until `coa-lab-mem glue`'s selection index names the wanted character,
# bounded by the character list's own length read from memory (never an infinite loop; wraps are not needed
# since Down alone reaches every index within one pass over a list of that length). Returns 0 once the
# highlighted character's name matches; 1 (refuse by name, never guess) if it never does within that many
# presses, or if memory stops answering partway through.
# L11 (2026-10-27) found live, slot 2, that the pre-existing "could not highlight X" failure's actual cause
# (at least once, reproduced with a screenshot) was not a navigation/name-matching defect at all: the client
# was force-disconnected back to the account-login screen (the same "You have been disconnected from the
# server" dialog as the login-time case) WHILE this loop was still polling character-select -- the character
# list it kept reading went stale/empty mid-navigation because the glue session itself dropped underneath it,
# the same server-side session instability already found causing the zero-gap kick race (see kick_via_soap's
# comment), manifesting here instead of during login. Return codes now distinguish the two: 1 is the
# original "never matched while still genuinely on character-select" (a real navigation/timing miss), 2 is
# "the screen stopped being character-select partway through" (a disconnect, not a navigation defect) -- the
# caller (cmd_login) reports a different, accurate message for each instead of one misleading "could not
# highlight" for both.
select_character_via_memory() {
    local character="$1" json count index name tries screen
    json=$(glue_state) || return 1
    screen=$(glue_field "$json" current_screen)
    [[ "$screen" == "charselect" ]] || return 2
    count=$(python3 -c '
import json, sys
try:
    print(len(json.load(sys.stdin).get("characters", [])))
except Exception:
    print(0)
' <<< "$json" 2> /dev/null) || count=0
    [[ "$count" =~ ^[0-9]+$ && "$count" -gt 0 ]] || return 1
    tries=0
    while (( tries < count )); do
        index=$(glue_field "$json" selection_index)
        name=$(python3 -c '
import json, sys
try:
    chars = json.load(sys.stdin).get("characters", [])
    index = int(sys.argv[1])
    print(chars[index] if 0 <= index < len(chars) else "")
except Exception:
    pass
' "$index" <<< "$json" 2> /dev/null)
        [[ "${name,,}" == "${character,,}" ]] && return 0
        xdotool key --window "$WINDOW" Down
        "$SLEEP" 1
        json=$(glue_state) || return 1
        screen=$(glue_field "$json" current_screen)
        [[ "$screen" == "charselect" ]] || return 2
        tries=$((tries + 1))
    done
    return 1
}

# Samples one pixel (top-center, where the account-login screen's bright logo/sky sits) and returns
# its R+G+B sum. Measured live (slot 2, 2026-10-26, 800x600): account-login srgb(176,155,148) (sum
# 479); character-select srgb(0,56,56) (sum 112, the same point over the character-select scene's dark
# background). LOGIN_SCREEN_BRIGHTNESS sits well between the two.
LOGIN_SCREEN_BRIGHTNESS=300

# The "You have been disconnected from the server." dialog covers the Username field with a red Okay
# button at (0.5, 0.514) of the window; memory does not show it (see glue_login_dialog_present). Measured
# at that point, 1024x768, slot 2, 2026-10-27: dialog srgb(67,1,0) to (230,1,0) (normal and highlighted
# button), clean login screen srgb(29,27,19). After a `.kick` the dialog can appear after the client is
# already on the login screen, so credentials typed at once went under it (2 of 4 switches after a fresh
# start, LOGIN_DISCONNECTED).
login_dialog_visible() {
    local path px r g b geometry
    geometry=$(xdotool getwindowgeometry --shell "$WINDOW") || return 1
    eval "$geometry"
    path="$STATE_DIR/screen-check.png"
    magick import -window "$WINDOW" "$path" 2> /dev/null || return 1
    px=$(magick "$path" -format "%[pixel:p{$((WIDTH / 2)),$((HEIGHT * 514 / 1000))}]" info: 2> /dev/null) || return 1
    IFS=',' read -r r g b _ <<< "${px#*(}"
    r=${r//[^0-9]/}; g=${g//[^0-9]/}; b=${b//[^0-9]/}
    [[ "$r" =~ ^[0-9]+$ && "$g" =~ ^[0-9]+$ && "$b" =~ ^[0-9]+$ ]] || return 1
    ((r > 50 && g < 15 && b < 15))
}

# Clicks Okay while the dialog is visible, then waits up to DIALOG_DISMISS_WAIT for it to go.
dismiss_visible_login_dialog() {
    login_dialog_visible || return 0
    local deadline=$((SECONDS + DIALOG_DISMISS_WAIT))
    xtest_click_pct 500 514 || return 1
    while login_dialog_visible; do
        ((SECONDS < deadline)) || return 1
        "$SLEEP" 0.3
    done
}

# A `.kick` always ends in that dialog: waits up to KICK_DIALOG_WAIT for it to appear, then dismisses it.
dismiss_kick_dialog() {
    local deadline=$((SECONDS + KICK_DIALOG_WAIT))
    until login_dialog_visible; do
        ((SECONDS < deadline)) || return 0
        "$SLEEP" 0.3
    done
    dismiss_visible_login_dialog
}

screen_brightness() {
    local path px r g b
    path="$STATE_DIR/screen-check.png"
    magick import -window "$WINDOW" "$path" 2> /dev/null || return 1
    px=$(magick "$path" -format "%[pixel:p{$((WIDTH / 2)),$((HEIGHT / 30))}]" info: 2> /dev/null) || return 1
    IFS=',' read -r r g b _ <<< "${px#*(}"
    r=${r//[^0-9]/}; g=${g//[^0-9]/}; b=${b//[^0-9]/}
    [[ "$r" =~ ^[0-9]+$ && "$g" =~ ^[0-9]+$ && "$b" =~ ^[0-9]+$ ]] || return 1
    echo $((r + g + b))
}

# True only once the sampled pixel is bright enough to be the account-login screen, not a guess from
# any other signal. Retries briefly (reports/l7, live, slot 2, 2026-10-26: reproduced 2/2 on the first
# attempt after switching `cmd_login`'s waits to `coa-lab-mem glue --until`): memory confirms the login
# screen (CGlueMgr::SetScreen) noticeably before the client has finished fading the scene in, where the
# old shell-side poll (GLUE_POLL_INTERVAL=2s plus its own python3 spawns) had already absorbed that delay
# by accident. IS_LOGIN_SCREEN_RETRY_WAIT is a ceiling, not a new fixed sleep: it returns as soon as the
# pixel check passes, same as every other wait this file turned into a bounded poll.
IS_LOGIN_SCREEN_RETRY_WAIT="${COA_LAB_LOGIN_SCREEN_RETRY_WAIT:-2}"
IS_LOGIN_SCREEN_RETRY_INTERVAL="${COA_LAB_LOGIN_SCREEN_RETRY_INTERVAL:-0.2}"
is_login_screen() {
    local sum waited=0
    while true; do
        sum=$(screen_brightness) && [[ -n "$sum" ]] && ((sum > LOGIN_SCREEN_BRIGHTNESS)) && return 0
        awk -v w="$waited" -v c="$IS_LOGIN_SCREEN_RETRY_WAIT" 'BEGIN { exit !(w < c) }' || return 1
        "$SLEEP" "$IS_LOGIN_SCREEN_RETRY_INTERVAL"
        waited=$(awk -v w="$waited" -v i="$IS_LOGIN_SCREEN_RETRY_INTERVAL" 'BEGIN { print w + i }')
    done
}

# Drives the client back to a clean account-login screen by restarting it on the same slot, instead
# of trying to navigate there from whatever state it is actually in. Replaces an earlier /camp + click
# "Back" recovery (ADR 0003 addendum): driven end-to-end inside one `login` process, that recovery
# reproducibly failed to reach the login screen in 4/4 full runs (up to ~330s each), for a cause that
# was never established (not verified), while a plain restart + the already-proven fresh-client path
# (start N, then LOGIN_WAIT + pixel check + type) is the one path this script has proven reliable.
# Reads the slot from state/slot before `cmd_stop` deletes that file. This can run in a different script
# invocation than the one that started the client (e.g. `login` driving an account switch), so
# COA_LAB_PROFILE/COA_LAB_DISPLAY/COA_LAB_WIDTH/HEIGHT/FPS in *this* process's environment are not
# necessarily the ones the running client was started with. state/profile (written by cmd_start, L16) is
# read instead and overrides the globals derived from this process's own environment, so the restart
# launches with the settings actually recorded for this instance; only the slot (an explicit argument,
# not state) also needs to be carried across the restart. A pre-L16 instance with no state/profile falls
# back to this process's environment, as before the fix.
restart_client() {
    local slot
    slot=$(cat "$STATE_DIR/slot" 2>/dev/null) || die "cannot restart the lab client: no recorded slot" \
        "(state/slot missing); coa-client-lab stop && start N"
    [[ "$slot" =~ ^[1-9][0-9]*$ ]] || die "cannot restart the lab client: state/slot is not a slot number: $slot"
    if [[ -f "$STATE_DIR/profile" ]]; then
        # shellcheck disable=SC1091
        source "$STATE_DIR/profile"
        MINIMAL_CVARS[0]="maxFPS=$FPS"
    fi
    step "restarting the lab client on slot $slot for a clean login (recorded instance/profile/resolution)"
    # A client restart changes neither the slot's server nor the lab's client files, so the preflight
    # recorded for this slot still describes them: keep it across cmd_stop, which deletes it.
    local preflight=""
    preflight=$(cat "$STATE_DIR/preflight" 2>/dev/null) || preflight=""
    cmd_stop
    cmd_start "$slot"
    [[ -z "$preflight" ]] || printf '%s\n' "$preflight" > "$STATE_DIR/preflight"
}

# Sequence and delays from the spike findings (Q2). The account field sits at x = width / 2,
# y = 315 / 600 of the height; `Return` on the character list works only once the list is loaded.
cmd_login() {
    local account="" password="" character=""
    if [[ "${1:-}" == "--account" ]]; then
        # Shared-account form (L9): the account's password was generated/reused by `character
        # --account NAME ...` through the same ensure_lab_password path as a dedicated account, and
        # that call always re-applies it to the account's real DB password (EnsureAccount), so no
        # password ever needs to appear on this command line.
        [[ $# -eq 3 ]] || die "usage: coa-client-lab login --account NAME CHARACTER"
        account="$2"; character="$3"
        [[ "$character" =~ ^[A-Za-z]+$ ]] || die "character names are letters only, got: $character"
        local pwfile
        pwfile=$(lab_password_file "$account")
        [[ -f "$pwfile" ]] \
            || die "no generated password for account $account (run: coa-client-lab character --account $account --character $character --race R --class K ... first)"
        password=$(cat "$pwfile")
    elif [[ $# -eq 1 ]]; then
        # Dedicated-account form: resolve the account and its generated password the same way
        # `character` derived and stored them, so this character never needs a character list.
        character="$1"
        [[ "$character" =~ ^[A-Za-z]+$ ]] || die "character names are letters only, got: $character"
        account=$(derive_account "$character")
        local pwfile
        pwfile=$(lab_password_file "$account")
        [[ -f "$pwfile" ]] \
            || die "no dedicated lab account for $character (run: coa-client-lab character --character $character --race R --class K ... without --account first)"
        password=$(cat "$pwfile")
    elif [[ $# -eq 2 || $# -eq 3 ]]; then
        account="$1"; password="$2"; character="${3:-}"
    else
        die "usage: coa-client-lab login ACCOUNT PASSWORD [CHARACTER] | login CHARACTER (dedicated account made by 'character' without --account) | login --account NAME CHARACTER (shared account made by 'character --account NAME ...')"
    fi
    require_running
    # L12: a same-account character switch (the new character shares the account already logged in this
    # session, per state/account) never needs to revisit the login screen at all: log out to
    # character-select in place (goto_charselect_via_memory, RBAC_PERM_INSTANT_LOGOUT-backed /camp) and
    # select the new character by name there, skipping the credential retype and its own confirmation
    # steps entirely. Only attempted when a character was actually requested (nothing to select
    # otherwise) and a prior login this session recorded the same account; any failure along this path
    # (logout did not confirm charselect-loaded in time, memory unusable, name never highlighted) falls
    # through to the full recovery path below exactly as if this block had not run -- goto_charselect_via_memory
    # and select_character_via_memory are read-driven and re-check state themselves, so a partial attempt
    # here is not assumed to have left the client anywhere unaccounted for.
    if [[ -n "$character" && -f "$STATE_DIR/account" ]]; then
        local prev_account=""
        prev_account=$(cat "$STATE_DIR/account" 2>/dev/null) || prev_account=""
        if [[ "$prev_account" == "$account" ]] && goto_charselect_via_memory; then
            local select_rc=0
            select_character_via_memory "$character" || select_rc=$?
            if [[ "$select_rc" == 0 ]]; then
                xdotool key --window "$WINDOW" Return
                glue_until in-world "$WORLD_WAIT" > /dev/null || true
                echo "login sent for $account (in-place character switch, no login screen); check the world with: coa-client-lab screenshot"
                write_descriptor "$account" "$character"
                wait_ui_ready "$character" || true
                return
            fi
            echo "WARN: in-place switch to $character did not confirm (rc=$select_rc); falling back to the" \
                 "full login-screen path" >&2
        fi
    fi
    # Credentials are only ever typed onto a screen this command has just confirmed is the clean
    # account-login screen. Two ways to get that confirmation, tried in order:
    #
    # 1. Memory (`coa-lab-mem glue`, read-only, same guards as every other memory read): if this session
    #    has attempted a login before and memory already confirms the login screen right now
    #    (`goto_login_screen_via_memory`), nothing else is needed. It does not try to *drive* the client
    #    there any more (see that function's own comment for why, and the real bug fixed along the way).
    # 2. Restart (`restart_client`): proven reliable end-to-end inside one `login` process (ADR 0003).
    #    Used whenever (1) does not already hold -- in world, at character-select, or memory unusable --
    #    so the same restart this script has always used for every non-login starting state.
    #
    # On a fresh client since the last `start` (no state/account file yet), nothing has touched the glue
    # screens and the client's own default state is the account-login screen already (confirmed live,
    # slot 2, 2026-10-26: sending a blind dismiss Return here, unconditionally, instead corrupted the
    # account field, since the client's default-focused control on an untouched login screen is not that
    # field), so neither (1) nor (2) runs for a fresh client.
    if [[ -f "$STATE_DIR/account" ]] && ! goto_login_screen_via_memory; then
        restart_client
        require_running
    fi
    # A fresh client (or one just restarted above) has not finished loading the glue screen yet. Memory,
    # when it is usable, turns each of this command's old fixed sleeps into a bounded poll on the real
    # state instead (measured live, 2026-10-26: a manual launch + login reaches the login screen well
    # under LOGIN_WAIT's 20s); each still never waits longer than the original constant, so a condition
    # memory cannot confirm (or a client memory cannot read at all) costs no more than before.
    local glued
    glued=$(glue_until login "$LOGIN_WAIT" 2> /dev/null) || true
    # No answer from memory (Warden on, or coa-lab-mem unusable) means nothing waited for the glue screen:
    # let the pixel check itself wait up to LOGIN_WAIT instead of failing on a client still loading.
    [[ -n "$glued" ]] || IS_LOGIN_SCREEN_RETRY_WAIT="$LOGIN_WAIT"
    # The pixel-brightness check (`is_login_screen`) still runs unconditionally, even when memory already
    # confirmed the screen: it also catches a leftover error dialog layered over the login screen (e.g. a
    # previous wrong-password attempt), which shares the same `current_screen` value in memory ("login")
    # but is not safe to type into -- memory alone cannot tell the two apart, since
    # `CGlueMgr::m_currentScreen` only names the glue screen, not whether a modal is on top of it.
    if glue_state > /dev/null 2>&1; then
        local confirm_screen
        confirm_screen=$(glue_field "$(glue_state)" current_screen)
        if [[ -z "$confirm_screen" || "$confirm_screen" == unknown ]]; then
            glue_until login "$LOGIN_WAIT" > /dev/null 2>&1 || true
            confirm_screen=$(glue_field "$(glue_state)" current_screen)
        fi
        [[ "$confirm_screen" == "login" ]] \
            || die "memory no longer confirms the account-login screen (current_screen=${confirm_screen:-unknown});" \
                   "refusing to type credentials."
    fi
    is_login_screen \
        || die "the account-login screen is not confirmed (pixel check failed);" \
               "see $STATE_DIR/screen-check.png. Refusing to type credentials."
    # A leftover "You have been disconnected from the server" (or similar) dialog shares current_screen
    # and the brightness check with a clean login screen (comment above), so neither guard above can see
    # one. Unconditionally clicking dismiss here (XTEST) was tried and reverted (reports/l8, live, slot 2,
    # 2026-10-26): it broke the previously-reliable fresh-login path (regression reproduced live, isolated
    # with `git stash`), most likely XTEST's own `windowactivate` disturbing focus for the credential click
    # two lines below, which stays the XSendEvent form. L11 (2026-10-27) adds a narrow, gated dismiss here
    # instead of an unconditional one: `dismiss_login_dialog_via_memory` only clicks when `coa-lab-mem glue`
    # confirms login_state == LOGIN_STATE_FAILED, the one dialog trigger (this client's own login attempt
    # rejected: wrong password, already online, a duplicate-session disconnect, ...) this session found a
    # reliable memory signal for -- see `glue_login_dialog_present`'s comment for the other trigger (an
    # already-in-world client kicked) this did NOT find a signal for; that one is instead cleared earlier,
    # unconditionally, in `goto_login_screen_via_memory` (`clear_login_dialog_unconditionally`), which this
    # function already ran via the `-f "$STATE_DIR/account"` check in `cmd_login` above, for any call where
    # a previous login was attempted this session. This gate therefore mainly guards a fresh client (no
    # prior `goto_login_screen_via_memory` call this session) that still somehow shows a login_state==5
    # dialog, and is intentionally narrow rather than unconditional, to stay clear of the ADR 0007 regression
    # site. When `coa-lab-mem` is unusable at all, this is a no-op and the pre-existing gap stands (a
    # leftover dialog then still needs a restart, `coa-client-lab stop && start N`).
    if glue_state > /dev/null 2>&1; then
        dismiss_login_dialog_via_memory \
            || die "a result dialog is still on the account-login screen after trying to dismiss it" \
                   "(login_state stayed LOGIN_STATE_FAILED); see $STATE_DIR/screen-check.png."
    fi
    dismiss_visible_login_dialog \
        || die "the \"disconnected\" dialog is still over the login fields after clicking Okay;" \
               "see $STATE_DIR/screen-check.png. Refusing to type credentials."
    echo "$account" > "$STATE_DIR/account"
    local geometry
    geometry=$(xdotool getwindowgeometry --shell "$WINDOW") || die "cannot read the size of window $WINDOW"
    eval "$geometry"
    # L13 (2026-10-27, slot 2, live): a fixed run of 20 BackSpace keys does not reliably clear a field that
    # already held a *different* account's text from a previous fast switch -- reproduced live, screen-check.png:
    # after Coalabres -> Labswitch the Username field read "COALABCOALABRESLABS", the prior account's text
    # untouched with the new one's tail appended, an unrecognized account the server/client reject outright
    # (explains a LOGIN_DISCONNECTED with no corresponding WorldSocket::HandleAuthSession line at all -- see
    # agent-protocol progress notes). Select-all + Delete clears the field regardless of its prior length or
    # the click's exact cursor position, unlike a fixed backspace count.
    xdotool mousemove --window "$WINDOW" $((WIDTH / 2)) $((HEIGHT * 315 / 600)) click 1
    "$SLEEP" 0.5
    xdotool key --window "$WINDOW" ctrl+a
    xdotool key --window "$WINDOW" Delete
    xdotool type --window "$WINDOW" --delay 40 "$account"
    xdotool key --window "$WINDOW" Tab
    "$SLEEP" 0.3
    xdotool key --window "$WINDOW" ctrl+a
    xdotool key --window "$WINDOW" Delete
    xdotool type --window "$WINDOW" --delay 40 "$password"
    xdotool key --window "$WINDOW" Return
    # `login-settled` (L11, 2026-10-27) stops as soon as either the character list loads or the client's own
    # login_state records a failure (wrong password, already online, banned, ...), instead of always waiting
    # out REALM_WAIT -- fails fast with the client's own login_result_name rather than a timeout that then
    # goes on to misreport the real cause (ADR 0007/8's "could not highlight" symptom was often this: a
    # login failure, not a character-select defect). Falls back to the old unconditional wait when
    # coa-lab-mem is unusable.
    if json=$(glue_until login-settled "$REALM_WAIT" 2> /dev/null); then
        :
    else
        json=$(glue_state 2> /dev/null) || json=""
    fi
    if [[ -n "$json" ]]; then
        local settled_state settled_result_name
        settled_state=$(glue_field "$json" login_state)
        settled_result_name=$(glue_field "$json" login_result_name)
        if [[ "$settled_state" == "5" ]]; then
            printf 'ERROR: login failed: %s (see %s)\n' "$settled_result_name" "$STATE_DIR/screen-check.png" >&2
            [[ "$settled_result_name" == LOGIN_DISCONNECTED ]] && exit "$LOGIN_REJECTED_EXIT"
            exit 1
        fi
    fi
    if [[ -n "$character" ]]; then
        # `glue_until charselect-loaded` above already waited for the character list to be loaded (when
        # memory is usable); re-check here only confirms memory is still usable right now. L11 (2026-10-27):
        # this single check is itself exposed to the same transient server-side instability documented at
        # kick_via_soap and select_character_via_memory -- reproduced live, slot 2: `glue_state` failed right
        # at this exact point once, sending this call to the `else` branch (`select_character`, which has no
        # name confirmation and silently uses the client's default-highlighted character), and the client
        # entered the world as the WRONG character with only a WARN, not a failure. A short retry here closes
        # that window instead of falling back to the unconfirmed path on a single transient miss; it still
        # falls back exactly as before if memory stays unusable for GLUE_STATE_RETRY_ATTEMPTS in a row.
        local glue_ready="" attempt
        for ((attempt = 1; attempt <= GLUE_STATE_RETRY_ATTEMPTS; attempt++)); do
            glue_state > /dev/null 2>&1 && { glue_ready=1; break; }
            [[ "$attempt" -lt "$GLUE_STATE_RETRY_ATTEMPTS" ]] && "$SLEEP" "$GLUE_STATE_RETRY_WAIT"
        done
        if [[ -n "$glue_ready" ]]; then
            local select_rc=0
            select_character_via_memory "$character" || select_rc=$?
            case "$select_rc" in
                0) ;;
                2) printf 'ERROR: %s\n' "disconnected during character selection (the client returned to the" \
                       "login screen while selecting $character, not a navigation failure); see" \
                       "$STATE_DIR/screen-check.png." >&2
                   exit "$LOGIN_DISCONNECTED_EXIT" ;;
                *) die "could not highlight $character in the character-select list within its own length;" \
                       "refusing to enter the world as an unconfirmed character. See $STATE_DIR/screen-check.png." ;;
            esac
        else
            select_character "$account" "$character"
        fi
    fi
    xdotool key --window "$WINDOW" Return
    glue_until in-world "$WORLD_WAIT" > /dev/null || true
    # Sound is silenced through Config.wtf, written by apply_profile on every start (reports/l7: the client
    # rewrites its own Config.wtf on exit, so this has to be reasserted at every start, not just `create`;
    # proven live by reading the CVar back in world: `coa-client-lab probe eval 'GetCVar("Sound_EnableAllSound")'`
    # -- see docs/design/client-lab-level3.md). No in-world /console round trip is needed any more.
    echo "login sent for $account; check the world with: coa-client-lab screenshot"
    if [[ -n "$character" ]]; then
        write_descriptor "$account" "$character"
        wait_ui_ready "$character" || true
    fi
}

# The lab descriptor tells coa-lab-relay (and the server repo's client_lab check) where to send relay probes.
# `preflight` is "pass" only for a pass recorded for this slot after the slot's last deploy; an older or foreign
# pass is "stale". The recorded slot and times are copied too, so the server check can apply the same rule.
write_descriptor() {
    local account="$1" character="$2" slot state_file etc relay_env
    [[ "$character" =~ ^[A-Za-z]+$ ]] || die "character names are letters only, got: $character"
    slot=$(cat "$STATE_DIR/slot" 2>/dev/null) || slot=""
    if ! relay_env=$(relay_env_for_slot "$slot"); then
        echo "no relay configuration for slot ${slot:-unknown} (coa-client-lab relay-setup ${slot:-N} ...):" \
             "no lab descriptor written"
        return 0
    fi
    state_file=$(coa-slot env "$slot" 2>/dev/null | sed -n 's/^STATE_FILE=//p') || state_file=""
    etc=$(coa-slot env "$slot" 2>/dev/null | sed -n 's/^ETC=//p') || etc=""
    ( umask 077
      python3 - "$relay_env" "$STATE_DIR/lab.json" "${COA_LAB_INSTANCE:-}" "$slot" "$account" \
          "$character" "${state_file:-/nonexistent}" "$STATE_DIR/preflight" "$LAB_CLIENT" \
          "${etc:+$etc/worldserver.conf}" <<'PYEOF'
import json
import sys
from datetime import datetime

(env_path, out, instance, slot, account, character, state_path, preflight_path, client_dir,
 worldserver_conf) = sys.argv[1:]


def first_line(path):
    try:
        with open(path) as handle:
            return handle.readline().split()
    except OSError:
        return []


def when(text):
    try:
        return datetime.fromisoformat(text)
    except ValueError:
        return None


env = {}
for line in open(env_path):
    key, sep, value = line.strip().partition("=")
    if sep:
        env[key] = value
if env.get("SLOT") != slot:
    sys.exit(f"{env_path} is set up for slot {env.get('SLOT')}, the lab client runs on slot {slot}: "
             f"run coa-client-lab relay-setup {slot} ...")
deploy = first_line(state_path)
deployed_commit = deploy[1] if len(deploy) > 1 else "unknown"
deployed_at = deploy[2] if len(deploy) > 2 else "unknown"
record = first_line(preflight_path)
result = record[0] if record else "unknown"
preflight_slot = record[2] if len(record) > 2 and record[1] == "slot" else "unknown"
preflight_time = record[3] if len(record) > 3 else "unknown"
checked, deployed = when(preflight_time), when(deployed_at)
if result == "pass" and not (preflight_slot == slot and checked and deployed and checked >= deployed):
    result = "stale"
descriptor = {
    "instance": instance, "slot": int(slot) if slot.isdigit() else slot,
    "soap_url": env["SOAP_URL"], "soap_account": env["SOAP_ACCOUNT"],
    "soap_password_file": env["SOAP_PASSWORD_FILE"], "account": account.upper(), "character": character,
    "deployed_commit": deployed_commit, "deployed_at": deployed_at, "preflight": result,
    "preflight_slot": int(preflight_slot) if preflight_slot.isdigit() else preflight_slot,
    "preflight_time": preflight_time, "client_dir": client_dir,
    "worldserver_conf": worldserver_conf or None,
}
with open(out, "w") as handle:
    json.dump(descriptor, handle, indent=2, sort_keys=True)
    handle.write("\n")
PYEOF
    ) || die "no lab descriptor written"
    echo "lab descriptor: $STATE_DIR/lab.json (preflight: $(python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))["preflight"])' "$STATE_DIR/lab.json"))"
}

# Hold a key down: walking, turning and any other continuous input the client reads as "key still pressed".
cmd_hold() {
    [[ $# -eq 2 ]] || die "usage: coa-client-lab hold KEY MILLISECONDS"
    [[ "$2" =~ ^[0-9]+$ ]] || die "hold duration must be milliseconds, got: $2"
    require_running
    xdotool keydown --window "$WINDOW" "$1"
    "$SLEEP" "$(awk -v ms="$2" 'BEGIN { printf "%.3f", ms / 1000 }')"
    xdotool keyup --window "$WINDOW" "$1"
}

#
# L15 problem 1: a separate `screenshot` call per frame cannot catch a sub-second effect (e.g. a brief
# projectile) -- each call is a fresh dispatch from whatever drives this script, so the gap between two
# calls is that dispatch's own overhead, not anything this script controls. `--burst`/`--video-seconds`
# capture several frames (or a short clip) inside ONE call, optionally after firing the trigger action
# (`--chat`/`--key`) in that same call, so no second dispatch sits between the action and the first frame.
# The legacy `screenshot [PATH]` form (no flags) is unchanged.
cmd_screenshot() {
    require_running
    local path="" burst=0 interval_ms=100 video_seconds=0 fps="" outdir="" chat_text="" key_args=()
    if [[ $# -gt 0 && "$1" != --* ]]; then
        path="$1"
        shift
    fi
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --burst) [[ $# -ge 2 ]] || die "--burst needs a value"; burst="$2"; shift 2 ;;
            --interval-ms) [[ $# -ge 2 ]] || die "--interval-ms needs a value"; interval_ms="$2"; shift 2 ;;
            --video-seconds) [[ $# -ge 2 ]] || die "--video-seconds needs a value"; video_seconds="$2"; shift 2 ;;
            --fps) [[ $# -ge 2 ]] || die "--fps needs a value"; fps="$2"; shift 2 ;;
            --dir) [[ $# -ge 2 ]] || die "--dir needs a value"; outdir="$2"; shift 2 ;;
            --chat) [[ $# -ge 2 ]] || die "--chat needs a value"; chat_text="$2"; shift 2 ;;
            --key) [[ $# -ge 2 ]] || die "--key needs a value"; key_args+=("$2"); shift 2 ;;
            *) die "unknown screenshot argument: $1" ;;
        esac
    done
    [[ "$burst" =~ ^[0-9]+$ ]] || die "--burst needs a non-negative integer frame count"
    [[ "$interval_ms" =~ ^[0-9]+$ ]] || die "--interval-ms needs a non-negative integer"
    [[ "$video_seconds" =~ ^[0-9]+$ ]] || die "--video-seconds needs a non-negative integer"
    [[ "$fps" == "" || "$fps" =~ ^[1-9][0-9]*$ ]] || die "--fps needs a positive integer"
    [[ "$burst" == 0 || "$video_seconds" == 0 ]] || die "use --burst or --video-seconds, not both"

    if [[ "$burst" == 0 && "$video_seconds" == 0 ]]; then
        [[ ${#key_args[@]} -eq 0 && -z "$chat_text" ]] || die "--chat/--key need --burst or --video-seconds"
        path="${path:-$LAB_ROOT/screenshots/lab-$(date +%Y%m%d-%H%M%S).png}"
        mkdir -p "$(dirname "$path")"
        magick import -window "$WINDOW" "$path"
        echo "$path"
        return 0
    fi
    [[ -z "$path" ]] || die "--burst/--video-seconds write a directory (--dir), not a single PATH"
    outdir="${outdir:-$LAB_ROOT/screenshots/burst-$(date +%Y%m%d-%H%M%S)-$$}"
    mkdir -p "$outdir"

    # Fire the trigger action, if any, then start capture immediately: no second command dispatch, no
    # extra round trip. action_ns is the timestamp of the LAST action sent (the one whose effect capture
    # cares about), so a later reader can compute the delay to the first frame.
    local action_ns
    action_ns=$(date +%s%N)
    if [[ -n "$chat_text" ]]; then
        xdotool key --window "$WINDOW" Return
        "$SLEEP" 0.5
        xdotool type --window "$WINDOW" --delay 40 "$chat_text"
        xdotool key --window "$WINDOW" Return
        action_ns=$(date +%s%N)
    fi
    if [[ ${#key_args[@]} -gt 0 ]]; then
        xdotool key --window "$WINDOW" "${key_args[@]}"
        action_ns=$(date +%s%N)
    fi

    if [[ "$video_seconds" != 0 ]]; then
        fps="${fps:-10}"
        local video="$outdir/clip.mp4" capture_start_ns
        printf 'action_ns\t%s\n' "$action_ns" > "$outdir/timing.tsv"
        capture_start_ns=$(date +%s%N)
        printf 'capture_start_ns\t%s\n' "$capture_start_ns" >> "$outdir/timing.tsv"
        # x11grab's window_id option selects the window within the display given as -i; the display
        # itself (not the window id) is the input, matching ffmpeg's own x11grab usage.
        ffmpeg -y -loglevel warning -f x11grab -window_id "$WINDOW" -framerate "$fps" -i "$DISPLAY" \
            -t "$video_seconds" "$video" > "$outdir/ffmpeg.log" 2>&1
        echo "$video"
        return 0
    fi

    : > "$outdir/timing.tsv"
    printf 'action_ns\t%s\n' "$action_ns" >> "$outdir/timing.tsv"
    local i frame_start frame_end elapsed_ms remaining_ms
    for ((i = 0; i < burst; i++)); do
        frame_start=$(date +%s%N)
        magick import -window "$WINDOW" "$outdir/frame-$(printf '%03d' "$i").png" 2> /dev/null || true
        frame_end=$(date +%s%N)
        printf 'frame\t%s\t%s\t%s\n' "$i" "$frame_start" "$frame_end" >> "$outdir/timing.tsv"
        if (( i < burst - 1 )); then
            elapsed_ms=$(( (frame_end - frame_start) / 1000000 ))
            remaining_ms=$(( interval_ms - elapsed_ms ))
            if (( remaining_ms > 0 )); then
                "$SLEEP" "$(printf '%d.%03d' "$((remaining_ms / 1000))" "$((remaining_ms % 1000))")"
            fi
        fi
    done
    echo "$outdir"
}

# The addon answers in SavedVariables, which the client writes on /reload (spike findings Q3).
cmd_probe() {
    [[ $# -ge 1 ]] || die "usage: coa-client-lab probe COMMAND [ARGS...]"
    [[ "$*" != *'|'* ]] || die "probe arguments cannot contain | (the chat edit box doubles it)"
    require_running
    if [[ -f "$STATE_DIR/lab.json" && "${COA_LAB_TRANSPORT:-relay}" != reload && "$RELAY_COMMANDS" == *" $1 "* ]]; then
        "$RELAY" --descriptor "$STATE_DIR/lab.json" probe "$@"
        return
    fi
    local account file req waited
    account=$(cat "$STATE_DIR/account" 2>/dev/null) || die "no login recorded: coa-client-lab login ACCOUNT PASSWORD"
    file="$LAB_CLIENT/WTF/Account/${account^^}/SavedVariables/CoaProbe.lua"
    req="p$(date +%s%N)"
    cmd_chat "/coaprobe $req $*"
    "$SLEEP" 1
    cmd_chat "/reload"
    for ((waited = 0; waited < PROBE_TIMEOUT; waited++)); do
        if python3 "$PROBE_READER" "$file" "$req"; then
            "$SLEEP" "$RELOAD_WAIT"
            return 0
        fi
        sleep 1
    done
    die "no CoaProbe answer for $req after ${PROBE_TIMEOUT}s: the client may still be reloading (a reload-path probe such as eval takes 10 to 60 s" \
        "under load); raise COA_LAB_PROBE_TIMEOUT and read it again, see $file"
}

cmd_stop() {
    local pid child tree changed waited file
    if [[ ! -e "$LOCK" ]]; then
        echo "not running"
        return 0
    fi
    if pid=$(gamescope_pid); then
        # Snapshot once, before any signal: descendants come and go, and the escalation branch below
        # needs the same PID list it started with to sweep up anything gamescope's own death orphans.
        tree=$(descendants "$pid")
        # Stop the Windows client first: gamescope exits when its child does (spike findings).
        for child in $tree; do
            if tr '\0' '\n' < "/proc/$child/cmdline" 2>/dev/null | head -1 \
                | grep -q '\\ascension-lab\\Ascension\.exe$'; then
                kill "$child" 2>/dev/null || true
            fi
        done
        for ((waited = 0; waited < STOP_TIMEOUT; waited++)); do
            kill -0 "$pid" 2>/dev/null || break
            sleep 1
        done
        if kill -0 "$pid" 2>/dev/null; then
            kill "$pid" 2>/dev/null || true
            sleep 5
            if kill -0 "$pid" 2>/dev/null; then
                kill -9 "$pid" 2>/dev/null || true
                # gamescope dying does not take its children with it: reap whatever the snapshot still has.
                for child in $tree; do
                    kill -0 "$child" 2>/dev/null && kill -9 "$child" 2>/dev/null || true
                done
            fi
        fi
    fi
    if [[ -e "$STATE_DIR/started" ]]; then
        changed=$(cd "$USER_CLIENT" && find WTF Interface -type f -newer "$STATE_DIR/started" 2>/dev/null | head -20) || true
        if [[ -n "$changed" ]]; then
            echo "WARN: the user's client changed during the lab run (the user playing, or a defect):"
            while IFS= read -r file; do
                echo "WARN:   $file"
            done <<< "$changed"
        fi
    fi
    if command -v pactl > /dev/null && [[ -z "$(other_locks)" ]]; then
        while read -r module; do
            [[ -n "$module" ]] && pactl unload-module "$module" || true
        done < <(pactl list short modules | awk -v name="sink_name=$SILENT_SINK" '$0 ~ name { print $1 }')
    fi
    rm -f "$LOCK" "$STATE_DIR/gamescope.pid" "$STATE_DIR/display" "$STATE_DIR/window" "$STATE_DIR/started" \
        "$STATE_DIR/gamescope.starttime" "$STATE_DIR/account" "$STATE_DIR/lab.json" "$STATE_DIR/slot" \
        "$STATE_DIR/preflight"
    echo "lab client stopped"
}

cmd_preflight() {
    local n="${1:-}" status=0
    [[ "$n" =~ ^[1-9][0-9]*$ ]] || die "usage: coa-client-lab preflight N"
    shift
    mkdir -p "$STATE_DIR"
    coa-slot preflight "$n" --client-data "$LAB_CLIENT/Data" --skip-harness "$@" || status=$?
    warden_status_line "$n"
    if [[ "$status" == 0 ]]; then
        echo "pass slot $n $(date -Is)" > "$STATE_DIR/preflight"
    else
        echo "fail slot $n $(date -Is)" > "$STATE_DIR/preflight"
    fi
    return "$status"
}

# Idempotent helper for a lab account created before this change (or any lab account whose grant was
# skipped, e.g. no relay.env at the time): grants RBAC_PERM_INSTANT_LOGOUT the same way `character` now
# does automatically for new ones. Takes the account name as stored (derive_account upper-cases it;
# accepted either case here and upper-cased before the lab-prefix check/grant).
cmd_rbac_grant() {
    local account=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --account) account="${2:-}"; shift 2 ;;
            *) die "unknown rbac-grant argument: $1" ;;
        esac
    done
    [[ -n "$account" ]] || die "usage: coa-client-lab rbac-grant --account NAME"
    account=$(tr '[:lower:]' '[:upper:]' <<<"$account")
    grant_instant_logout_rbac "$account" || die "RBAC_PERM_INSTANT_LOGOUT grant failed for $account"
    echo "RBAC_PERM_INSTANT_LOGOUT granted to $account"
}

cmd_relay_setup() {
    local n="${1:-}" account="" password_file="" etc
    [[ "$n" =~ ^[1-9][0-9]*$ ]] || die "usage: coa-client-lab relay-setup N --soap-account NAME --soap-password-file PATH"
    shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --soap-account) account="${2:-}"; shift 2 ;;
            --soap-password-file) password_file="${2:-}"; shift 2 ;;
            *) die "unknown relay-setup argument: $1" ;;
        esac
    done
    [[ "$account" =~ ^[A-Za-z0-9]+$ ]] || die "relay-setup needs --soap-account NAME (letters and digits)"
    [[ -f "$password_file" ]] || die "relay-setup needs --soap-password-file PATH (an existing file)"
    password_file=$(realpath -- "$password_file")
    etc=$(coa-slot env "$n" | sed -n 's/^ETC=//p')
    [[ -n "$etc" && -f "$etc/worldserver.conf" ]] || die "coa-slot env $n gave no ETC with worldserver.conf"
    [[ -f "$etc/modules/coa.conf" ]] || die "no $etc/modules/coa.conf"
    set_conf "$etc/worldserver.conf" SOAP.Enabled 1
    set_conf "$etc/worldserver.conf" SOAP.IP '"0.0.0.0"'
    set_conf "$etc/modules/coa.conf" CoA.ProbeRelay.Enable 1

    # Each slot has its own auth DB: a SOAP account created on another slot does not exist here, and the
    # relay answers 401 until one does, at SEC_ADMINISTRATOR (TestLabSoapAccount's comment explains why).
    local ghost_env status=0
    ghost_env=$(coa-slot env "$n" | sed -n 's/^GHOST_ENV=//p')
    [[ -n "$ghost_env" && -f "$ghost_env" ]] || die "coa-slot env $n gave no readable GHOST_ENV (coa-slot create $n first?)"
    ( set -a; source "$ghost_env"; set +a
      export COA_LAB_SOAP_ACCOUNT="$account" COA_LAB_SOAP_PASSWORD="$(cat "$password_file")"
      run_lab_character -run '^TestLabSoapAccount$' . ) || status=$?
    [[ "$status" == 0 ]] || die "could not create/update the SOAP account $account on slot $n (go test output above)"

    # L14b: one file per slot under $LAB_ROOT/relay/, never the single shared $LAB_ROOT/relay.env every
    # slot and every lab instance used to overwrite (reports/l14-lab-fixes.md Concern 1: a relay-setup on
    # one slot silently broke another session's relay on a different slot). This never touches a
    # pre-existing $LAB_ROOT/relay.env (relay_env_for_slot still reads it, read only, for a setup made
    # before this change).
    mkdir -p "$LAB_ROOT/relay"
    ( umask 077
      printf 'SLOT=%s\nSOAP_URL=http://127.0.0.1:%s/\nSOAP_ACCOUNT=%s\nSOAP_PASSWORD_FILE=%s\n' \
          "$n" "$((7878 + (n - 1) * 100))" "$account" "$password_file" > "$LAB_ROOT/relay/slot${n}.env" )
    echo "relay configured for slot $n; restart: coa-slot compose $n restart ac-worldserver"
}

main() {
    local command="${1:-}"
    [[ $# -gt 0 ]] && shift
    case "$command" in
        create) cmd_create ;;
        destroy) cmd_destroy "$@" ;;
        create-instance) cmd_create_instance ;;
        destroy-instance) cmd_destroy_instance "$@" ;;
        start) cmd_start "$@" ;;
        status) cmd_status ;;
        type) cmd_type "$@" ;;
        key) cmd_key "$@" ;;
        chat) cmd_chat "$@" ;;
        login) login_with_retry "$@" ;;
        character) cmd_character "$@" ;;
        screenshot) cmd_screenshot "$@" ;;
        hold) cmd_hold "$@" ;;
        mute) cmd_mute ;;
        probe) cmd_probe "$@" ;;
        revive) cmd_revive "$@" ;;
        camera) cmd_camera "$@" ;;
        goto-spawn) cmd_goto_spawn "$@" ;;
        erase) cmd_erase "$@" ;;
        stop) cmd_stop ;;
        preflight) cmd_preflight "$@" ;;
        relay-setup) cmd_relay_setup "$@" ;;
        rbac-grant) cmd_rbac_grant "$@" ;;
        -h|--help|help|"") usage ;;
        *) usage >&2; exit 2 ;;
    esac
}

main "$@"; exit $?  # same line: an edit of this file cannot run half-read commands in a running copy
