#!/usr/bin/env python3
"""Run the CoA server repository's `tools/verify_all.py` inside the versioned `coa-verify-env` container,
from (or against) a worktree of that repository. Replaces the ad hoc per-task `verify.sh` wrappers agents wrote
by hand (see docs/tooling/verify-container.md and ADR 0018).

    coa-verify [--worktree DIR] [--ram] [--nopch] [VERIFY_ALL_ARGS...]

`--worktree DIR` selects the CoA checkout to run against; default is the current directory. The main checkout
(holding `.git`) is derived with `git -C DIR rev-parse --git-common-dir`, so this works from a linked worktree or
from the main checkout itself. Everything after the recognised options is passed through to
`tools/verify_all.py` unchanged, for example `--stages source` or `--ram --stages gameplay --scenario <id>`.

`--ram` points the run at the in-RAM test MySQL (docs/tooling/ram-mysql.md in this guide; the authoritative setup
is `docs/coa/verification.md`, "Optional: in-RAM test database", in the server repository) instead of copying the
worldserver config and MySQL client file into the worktree: it mounts the secrets directory read-only, creates
the worktree's `server_modules_dir`, writes a `--settings` JSON into the worktree's gitignored `.cache/`, and
checks the test MySQL container is running before it hands off to `tools/verify_all.py`.

`--nopch` builds without precompiled headers (`-DNOPCH=1`) in a separate `build-nopch` directory, so ccache can
reuse objects compiled in any other worktree at the same sources; it cannot be combined with a `--settings` of your
own (the settings file it writes carries `build_directory` and `cmake_args`).

Refuses (prints the fix, changes nothing) when: the image named by `COA_VERIFY_IMAGE` is missing (prints the
`docker build` command), or `--ram` is given but the test MySQL container is not running (prints how to start and
reseed it). Paths are overridable by environment variables; the defaults match this workstation's layout.

Environment variables:
    COA_VERIFY_IMAGE          image tag to run                           (coa-verify-env:24.04)
    COA_VERIFY_CCACHE_DIR     host ccache directory, created if missing  (~/.cache/coa-verify-ccache)
    COA_VERIFY_CCACHE_MAXSIZE ccache size limit                          (50G)
    COA_VERIFY_CCACHE_BASEDIR ccache base directory: hits across
                              worktrees below it   (common parent of the main checkout and the worktree)
    COA_SRV_COA               read-only server data/etc/env-file root    (/srv/coa)
    COA_TEST_MYSQL            in-RAM test MySQL container name           (coa-test-mysql)
    COA_TEST_MYSQL_SECRETS    directory with worldserver.ram.conf and
                              ram-client.cnf, mounted read-only          (~/CoaServer/test-mysql/secrets)
"""
import json
import os
import subprocess
import sys
from pathlib import Path

IMAGE = os.environ.get("COA_VERIFY_IMAGE", "coa-verify-env:24.04")
CCACHE_DIR = Path(os.environ.get("COA_VERIFY_CCACHE_DIR", str(Path.home() / ".cache/coa-verify-ccache")))
CCACHE_MAXSIZE = os.environ.get("COA_VERIFY_CCACHE_MAXSIZE", "50G")
CCACHE_BASEDIR = os.environ.get("COA_VERIFY_CCACHE_BASEDIR")
CCACHE_SLOPPINESS = "pch_defines,time_macros,include_file_mtime,include_file_ctime"
SRV_COA = Path(os.environ.get("COA_SRV_COA", "/srv/coa"))
TEST_MYSQL = os.environ.get("COA_TEST_MYSQL", "coa-test-mysql")
TEST_MYSQL_SECRETS = Path(os.environ.get("COA_TEST_MYSQL_SECRETS", str(Path.home() / "CoaServer/test-mysql/secrets")))

BUILD_HINT = (
    "docker build -t {image} -f docker/coa-verify-env/Dockerfile docker/coa-verify-env"
    "   # from this guide's checkout"
)


class Refused(Exception):
    pass


def run_git(worktree: Path, *args: str) -> str:
    result = subprocess.run(["git", "-C", str(worktree), *args], capture_output=True, text=True)
    if result.returncode != 0:
        raise Refused(f"git {' '.join(args)} failed in {worktree}: {result.stderr.strip()}")
    return result.stdout.strip()


def main_checkout(worktree: Path) -> Path:
    common_dir = Path(run_git(worktree, "rev-parse", "--git-common-dir"))
    if not common_dir.is_absolute():
        common_dir = (worktree / common_dir).resolve()
    return common_dir.parent


def image_present(image: str, docker=subprocess.run) -> bool:
    result = docker(["docker", "image", "inspect", image], capture_output=True, text=True)
    return result.returncode == 0


def mysql_running(container: str, docker=subprocess.run) -> bool:
    result = docker(["docker", "ps", "--filter", f"name=^{container}$", "--format", "{{.Names}}"],
                     capture_output=True, text=True)
    return result.returncode == 0 and container in result.stdout.split()


def ram_settings(tree: Path, secrets: Path = TEST_MYSQL_SECRETS, srv_coa: Path = SRV_COA) -> dict:
    return {
        "worldserver_config": str(secrets / "worldserver.ram.conf"),
        "modules_config_dir": str(srv_coa / "etc/modules"),
        "server_modules_dir": str(tree / "env/dist/etc/modules"),
        "mysql": "/usr/bin/mysql",
        "mysqldump": "/usr/bin/mysqldump",
        "database_client_config": str(secrets / "ram-client.cnf"),
        "dbc_directory": str(srv_coa / "server-data/dbc"),
    }


def nopch_settings(tree: Path) -> dict:
    return {
        "build_directory": "build-nopch",
        "cmake_args": ["-G", "Ninja", "-DCMAKE_BUILD_TYPE=RelWithDebInfo", "-DAPPS_BUILD=world-only",
                       "-DSCRIPTS=static", "-DMODULES=static", "-DBUILD_TESTING=ON",
                       f"-DCMAKE_INSTALL_PREFIX={tree / 'env/dist'}", "-DNOPCH=1"],
    }


def write_settings(tree: Path, settings: dict, name: str = "settings.ram.json") -> Path:
    settings_dir = tree / ".cache/coa-verify"
    settings_dir.mkdir(parents=True, exist_ok=True)
    settings_path = settings_dir / name
    settings_path.write_text(json.dumps(settings, indent=2) + "\n")
    return settings_path


def build_docker_command(repo: Path, tree: Path, ccache_dir: Path, image: str, verify_args: list,
                          srv_coa: Path = SRV_COA, ram_secrets: Path = None) -> list:
    command = ["docker", "run", "--rm", "--init", "--network", "host",
               "--user", f"{os.getuid()}:{os.getgid()}"]
    mounts = {str(repo): str(repo)}
    if str(tree) != str(repo):
        mounts[str(tree)] = str(tree)
    mounts[str(ccache_dir)] = "/ccache"
    for source, target in mounts.items():
        command += ["-v", f"{source}:{target}"]
    if (srv_coa / "server-data").is_dir():
        command += ["-v", f"{srv_coa / 'server-data'}:{srv_coa / 'server-data'}:ro"]
    if (srv_coa / "etc").is_dir():
        command += ["-v", f"{srv_coa / 'etc'}:{srv_coa / 'etc'}:ro"]
    if ram_secrets is not None:
        command += ["-v", f"{ram_secrets}:{ram_secrets}:ro"]
    env_file = srv_coa / "coa.env"
    if env_file.is_file():
        command += ["--env-file", str(env_file)]
    basedir = CCACHE_BASEDIR or os.path.commonpath([str(repo.parent), str(tree.parent)])
    command += [
        "-e", "HOME=/tmp",
        "-e", "CCACHE_DIR=/ccache",
        "-e", f"CCACHE_MAXSIZE={CCACHE_MAXSIZE}",
        "-e", f"CCACHE_SLOPPINESS={CCACHE_SLOPPINESS}",
        "-e", f"CCACHE_BASEDIR={basedir}",
        "-e", "CCACHE_NOHASHDIR=1",
        "-e", "GIT_CONFIG_COUNT=1",
        "-e", "GIT_CONFIG_KEY_0=safe.directory",
        "-e", "GIT_CONFIG_VALUE_0=*",
        "-e", "CMAKE_CXX_COMPILER_LAUNCHER=ccache",
        "-e", "CMAKE_C_COMPILER_LAUNCHER=ccache",
        "-w", str(tree),
        image,
        "python3", "-B", "tools/verify_all.py", *verify_args,
    ]
    return command


def run_docker(command: list) -> subprocess.CompletedProcess:
    return subprocess.run(command)


def main(argv: list) -> int:
    worktree = Path(".").resolve()
    ram = False
    nopch = False
    passthrough = []
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "--worktree":
            if i + 1 >= len(argv):
                print("ERROR: --worktree needs a directory", file=sys.stderr)
                return 2
            worktree = Path(argv[i + 1]).resolve()
            i += 2
            continue
        if arg == "--ram":
            ram = True
            i += 1
            continue
        if arg == "--nopch":
            nopch = True
            i += 1
            continue
        if arg in ("-h", "--help"):
            print(__doc__)
            return 0
        passthrough.append(arg)
        i += 1

    try:
        repo = main_checkout(worktree)
    except Refused as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 2

    if not image_present(IMAGE):
        print(f"ERROR: image {IMAGE} not found. Build it first:\n  {BUILD_HINT.format(image=IMAGE)}",
              file=sys.stderr)
        return 2

    own_settings = any(a == "--settings" or a.startswith("--settings=") for a in passthrough)
    if nopch and own_settings:
        print("ERROR: --nopch writes its own --settings file; add build_directory and cmake_args with -DNOPCH=1 to "
              "yours instead", file=sys.stderr)
        return 2

    ram_secrets = None
    settings = {}
    if ram:
        if not mysql_running(TEST_MYSQL):
            print(
                f"ERROR: container {TEST_MYSQL} is not running. Start it and reseed it before using --ram\n"
                f"  (see docs/tooling/ram-mysql.md in this guide and docs/coa/verification.md in the server "
                f"repository, \"Optional: in-RAM test database\"; reseed with `coa-slot reseed-test-mysql`).",
                file=sys.stderr,
            )
            return 2
        settings.update(ram_settings(worktree))
        (worktree / "env/dist/etc/modules").mkdir(parents=True, exist_ok=True)
        ram_secrets = TEST_MYSQL_SECRETS
    if nopch:
        settings.update(nopch_settings(worktree))
    if settings and not own_settings:
        settings_path = write_settings(worktree, settings, "settings.ram.json" if ram else "settings.nopch.json")
        passthrough += ["--settings", str(settings_path)]

    CCACHE_DIR.mkdir(parents=True, exist_ok=True)
    command = build_docker_command(repo, worktree, CCACHE_DIR, IMAGE, passthrough, ram_secrets=ram_secrets)
    return run_docker(command).returncode


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
